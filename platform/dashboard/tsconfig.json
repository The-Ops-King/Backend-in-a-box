{
  "compilerOptions": {
    "target": "ES2022", "lib": ["DOM", "DOM.Iterable", "ES2022"], "module": "ESNext", "moduleResolution": "bundler",
    "jsx": "react-jsx", "strict": true, "noEmit": true, "skipLibCheck": true, "isolatedModules": true, "esModuleInterop": true, "resolveJsonModule": true,
    "types": ["vite/client"],
    "paths": { "@/*": ["../src/*"], "~/*": ["./src/*"] }
  },
  "include": ["src", "vite.config.ts"]
}
