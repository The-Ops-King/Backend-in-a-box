DATABASE_URL=postgres://user:pass@host/db
BINDINGS_KEY=            # 32-byte base64 key for encrypting secret bindings
CRON_SECRET=             # Vercel sets Authorization: Bearer <CRON_SECRET> on cron calls
JEV_API_KEY=             # optional; without it the classifier returns "unclear"
OPERATOR_EMAIL=jt@jtylerray.com
ANTHROPIC_API_KEY=       # optional fallback for the analyze node; per-company secret.anthropic_key wins
PUBLIC_URL=              # https://<deployment>; used to register provider webhooks (Fathom) and for links in team alerts
OPERATOR_WEBHOOK_URL=    # optional; engine-wide problems (no company) and any company without alerts.webhook POST here (a Zap catch hook). Health: /api/health?assert=fresh → 503 when no tick for 5 min
RESEND_API_KEY=          # optional; alert email to the operator when a company sets alerts.email and has no key of its own (secret.resend_key)
ALERT_EMAIL_FROM=        # optional; the sender for alert email, on a domain verified in Resend (a company's alerts.email_from wins)
