{
  "slug": "payment-recorded",
  "name": "Payment recorded",
  "category": "payments",
  "stage": "payments",
  "sort": 20,
  "description": "A payment landed in the ledger: cash collected on the contact becomes the running total, revenue generated is stamped once with the program price, pay-plan-active or pay-paid-full is set, the payment is written to the CRM's Payment object and linked to the contact and the closer card. On the first payment, if the agreement is not signed yet, the purchase agreement is sent for signature, stat-agreement-sent is added and the closer card moves to Agreement Sent. A dated note records the payment, the Sales Call record's cash collected is updated when there is one, and the team gets the Slack line. Nothing goes to the customer from here.",
  "definition": {
    "schema": 1,
    "reentry": "always",
    "premise": {
      "check": "contact_exists"
    },
    "nodes": [
      {
        "id": "t1",
        "type": "trigger",
        "event": "payment.received"
      },
      {
        "id": "n1",
        "type": "update_contact",
        "fields": [
          {
            "id": "{{crm.field_contact_cash_collected}}",
            "value": "{{event.running_total}}"
          }
        ]
      },
      {
        "id": "n2",
        "type": "branch"
      },
      {
        "id": "r1",
        "type": "update_contact",
        "fields": [
          {
            "id": "{{crm.field_contact_revenue_generated}}",
            "value": "{{event.contract_value | default:}}"
          }
        ]
      },
      {
        "id": "n3",
        "type": "branch"
      },
      {
        "id": "f1",
        "type": "set_tag",
        "tag": [
          "pay-paid-full"
        ]
      },
      {
        "id": "f2",
        "type": "remove_tag",
        "tag": [
          "pay-plan-active"
        ]
      },
      {
        "id": "p1",
        "type": "set_tag",
        "tag": [
          "pay-plan-active"
        ]
      },
      {
        "id": "n4",
        "type": "crm_record",
        "object": "custom_objects.payment",
        "key": "{{event.provider_payment_id}}",
        "properties": {
          "display_label": "${{event.amount}} · {{contact.name | default:Unknown}} · {{event.paid_at | date_company:yyyy-MM-dd}}",
          "transaction_id": "{{event.provider_payment_id}}",
          "amount": "{{event.amount}}",
          "occurred_at": "{{event.paid_at}}",
          "type": "{{event.kind}}",
          "status": "succeeded",
          "processor": "whop",
          "contact_id": "{{contact.ghl_contact_id | default:}}",
          "opportunity_id": "{{cards.closer.id | default:}}",
          "closer": "{{cards.closer.owner.name | default:}}",
          "setter": "{{contact.fields.setter | default:}}"
        },
        "relate": [
          {
            "association": "{{crm.assoc_payment_contact}}",
            "first": "{{contact.ghl_contact_id | default:}}",
            "second": "{{record.id}}"
          },
          {
            "association": "{{crm.assoc_payment_opportunity}}",
            "first": "{{record.id}}",
            "second": "{{cards.closer.id | default:}}"
          }
        ]
      },
      {
        "id": "a0",
        "type": "branch"
      },
      {
        "id": "a1",
        "type": "send_document",
        "template": "{{crm.agreement_template}}",
        "sender": "{{crm.agreement_sender | default:}}",
        "name": "Purchase agreement"
      },
      {
        "id": "a2",
        "type": "set_tag",
        "tag": [
          "stat-agreement-sent"
        ]
      },
      {
        "id": "a3",
        "type": "pipeline_card",
        "pipeline": "{{crm.pipeline_closer}}",
        "stage": "{{crm.stage_closer_agreement_sent}}",
        "if_missing": "skip"
      },
      {
        "id": "m1",
        "type": "note",
        "template": "PAYMENT RECEIVED — {{event.paid_at | date_company}} · ${{event.amount}} ({{event.kind}}) · collected {{event.running_total}} of {{event.contract_value | default:?}}"
      },
      {
        "id": "b2",
        "type": "branch"
      },
      {
        "id": "r2",
        "type": "crm_record",
        "object": "custom_objects.sales_call",
        "key": "{{records.sales_call.key}}",
        "properties": {
          "cash_collected": "{{event.running_total}}"
        }
      },
      {
        "id": "n5",
        "type": "slack_post",
        "channel": "{{slack.channel.payments}}",
        "template": "*Payment received:* ${{event.amount | money}}\n*Name:* <https://app.gohighlevel.com/v2/location/{{crm.location_id}}/contacts/detail/{{contact.ghl_contact_id | default:}}|{{contact.name | default:Unknown}}>\n*Closer:* {{contact.closer.name | default:unassigned}}{{contact.setter.name | line:*Setter:*}}",
        "as": {
          "name": "Payment received",
          "icon": [
            ":moneybag:",
            ":money_with_wings:",
            ":money_mouth_face:",
            ":dollar:",
            ":heavy_dollar_sign:"
          ]
        }
      },
      {
        "id": "x1",
        "type": "exit",
        "reason": "recorded"
      }
    ],
    "edges": [
      {
        "from": "t1",
        "to": "n1"
      },
      {
        "from": "n1",
        "to": "n2"
      },
      {
        "from": "n2",
        "to": "r1",
        "when": {
          "not": {
            "exists": "contact.fields.revenue_generated"
          }
        },
        "label": "first time: stamp revenue"
      },
      {
        "from": "n2",
        "to": "n3",
        "else": true,
        "label": "already stamped"
      },
      {
        "from": "r1",
        "to": "n3"
      },
      {
        "from": "n3",
        "to": "f1",
        "when": {
          "eq": [
            "{{event.cleared}}",
            true
          ]
        },
        "label": "paid in full"
      },
      {
        "from": "n3",
        "to": "p1",
        "else": true,
        "label": "still owes"
      },
      {
        "from": "f1",
        "to": "f2"
      },
      {
        "from": "f2",
        "to": "n4"
      },
      {
        "from": "p1",
        "to": "n4"
      },
      {
        "from": "n5",
        "to": "x1"
      },
      {
        "from": "n4",
        "to": "a0"
      },
      {
        "from": "a0",
        "to": "a1",
        "when": {
          "and": [
            {
              "eq": [
                "{{event.prior_total}}",
                0
              ]
            },
            {
              "eq": [
                "{{contact.agreement_signed}}",
                false
              ]
            }
          ]
        },
        "label": "first payment, agreement not signed"
      },
      {
        "from": "a0",
        "to": "m1",
        "else": true,
        "label": "otherwise"
      },
      {
        "from": "a1",
        "to": "a2"
      },
      {
        "from": "a2",
        "to": "a3"
      },
      {
        "from": "a3",
        "to": "m1"
      },
      {
        "from": "m1",
        "to": "b2"
      },
      {
        "from": "b2",
        "to": "r2",
        "when": {
          "exists": "records.sales_call.key"
        },
        "label": "has a Sales Call record"
      },
      {
        "from": "b2",
        "to": "n5",
        "else": true,
        "label": "no Sales Call record"
      },
      {
        "from": "r2",
        "to": "n5"
      }
    ]
  }
}
