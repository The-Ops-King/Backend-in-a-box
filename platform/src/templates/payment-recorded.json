{
  "slug": "payment-recorded",
  "name": "Payment recorded",
  "category": "payments",
  "description": "A payment landed in the ledger: cash collected on the contact becomes the running total, revenue generated is stamped once with the program price, pay-plan-active or pay-paid-full is set, the payment is written to the CRM's Payment object and linked to the contact and the closer card, and the team gets a Slack line. Nothing goes to the customer from here.",
  "definition": {
    "schema": 1,
    "reentry": "always",
    "premise": {
      "check": "contact_exists"
    },
    "nodes": [
      {
        "id": "t1",
        "type": "trigger",
        "event": "payment.received"
      },
      {
        "id": "n1",
        "type": "update_contact",
        "fields": [
          {
            "id": "{{crm.field_contact_cash_collected}}",
            "value": "{{event.running_total}}"
          }
        ]
      },
      {
        "id": "n2",
        "type": "branch"
      },
      {
        "id": "r1",
        "type": "update_contact",
        "fields": [
          {
            "id": "{{crm.field_contact_revenue_generated}}",
            "value": "{{event.contract_value | default:}}"
          }
        ]
      },
      {
        "id": "n3",
        "type": "branch"
      },
      {
        "id": "f1",
        "type": "set_tag",
        "tag": [
          "pay-paid-full"
        ]
      },
      {
        "id": "f2",
        "type": "remove_tag",
        "tag": [
          "pay-plan-active"
        ]
      },
      {
        "id": "p1",
        "type": "set_tag",
        "tag": [
          "pay-plan-active"
        ]
      },
      {
        "id": "n4",
        "type": "crm_record",
        "object": "custom_objects.payment",
        "key": "{{event.provider_payment_id}}",
        "properties": {
          "display_label": "${{event.amount}} · {{contact.name | default:Unknown}} · {{event.paid_at | date_company:yyyy-MM-dd}}",
          "transaction_id": "{{event.provider_payment_id}}",
          "amount": "{{event.amount}}",
          "occurred_at": "{{event.paid_at}}",
          "type": "{{event.kind}}",
          "status": "succeeded",
          "processor": "whop",
          "contact_id": "{{contact.ghl_contact_id | default:}}",
          "opportunity_id": "{{cards.closer.id | default:}}",
          "closer": "{{cards.closer.owner.name | default:}}",
          "setter": "{{contact.fields.setter | default:}}"
        },
        "relate": [
          {
            "association": "{{crm.assoc_payment_contact}}",
            "first": "{{contact.ghl_contact_id | default:}}",
            "second": "{{record.id}}"
          },
          {
            "association": "{{crm.assoc_payment_opportunity}}",
            "first": "{{record.id}}",
            "second": "{{cards.closer.id | default:}}"
          }
        ]
      },
      {
        "id": "n5",
        "type": "slack_post",
        "channel": "{{slack.channel.payments}}",
        "template": "*Payment:* {{event.amount}} {{event.currency | upper}} · {{event.kind}}\n*From:* <https://app.gohighlevel.com/v2/location/{{crm.location_id}}/contacts/detail/{{contact.ghl_contact_id | default:}}|{{contact.name | default:Unknown}}>\n*Collected so far:* {{event.running_total}} of {{event.contract_value | default:?}} · outstanding {{event.outstanding | default:?}}\n*Closer:* {{cards.closer.owner.name | default:unassigned}} · *Setter:* {{contact.fields.setter | default:none}}"
      },
      {
        "id": "x1",
        "type": "exit",
        "reason": "recorded"
      }
    ],
    "edges": [
      {
        "from": "t1",
        "to": "n1"
      },
      {
        "from": "n1",
        "to": "n2"
      },
      {
        "from": "n2",
        "to": "r1",
        "when": {
          "not": {
            "exists": "contact.fields.revenue_generated"
          }
        },
        "label": "first time: stamp revenue"
      },
      {
        "from": "n2",
        "to": "n3",
        "else": true,
        "label": "already stamped"
      },
      {
        "from": "r1",
        "to": "n3"
      },
      {
        "from": "n3",
        "to": "f1",
        "when": {
          "eq": [
            "{{event.cleared}}",
            true
          ]
        },
        "label": "paid in full"
      },
      {
        "from": "n3",
        "to": "p1",
        "else": true,
        "label": "still owes"
      },
      {
        "from": "f1",
        "to": "f2"
      },
      {
        "from": "f2",
        "to": "n4"
      },
      {
        "from": "p1",
        "to": "n4"
      },
      {
        "from": "n4",
        "to": "n5"
      },
      {
        "from": "n5",
        "to": "x1"
      }
    ]
  }
}
