{
  "slug": "no-show-recovery",
  "name": "No-show recovery",
  "category": "no_show",
  "stage": "post_call",
  "sort": 20,
  "origin": "default",
  "description": "Ten minutes after a no-show (from GHL's status or our disposition form): text and email with the rebook link, a day for a reply, then one more email.",
  "definition": {
    "schema": 1,
    "reentry": "once_per_appointment",
    "premise": {
      "check": "appointment_exists"
    },
    "nodes": [
      {
        "id": "t1",
        "type": "trigger",
        "event": "appointment.status_changed",
        "match": {
          "eq": [
            "{{event.status.to}}",
            "noshow"
          ]
        }
      },
      {
        "id": "t2",
        "type": "trigger",
        "event": "appointment.outcome",
        "match": {
          "eq": [
            "{{event.outcome}}",
            "noshow"
          ]
        }
      },
      {
        "id": "n1",
        "type": "wait",
        "rule": {
          "anchor": "now",
          "offset": "+10m",
          "tz": "contact"
        }
      },
      {
        "id": "n2",
        "type": "send_sms",
        "template": "Hey {{contact.first_name | default:there}}, looks like we missed each other. Here's the link to grab a new time with {{appointment.closer.first_name}}: {{calendar.closer_call.url}}",
        "validity": {
          "anchor": "after_event",
          "max_lag": "3d"
        },
        "on_stale": "skip",
        "title": "Text the rebooking link"
      },
      {
        "id": "n3",
        "type": "send_email",
        "subject": "We missed you",
        "template": "<p>Hey {{contact.first_name | default:there}},</p><p>Looks like we missed each other for the call with {{appointment.closer.first_name}}. Things come up. If you still want to talk, pick a new time here: {{calendar.closer_call.url}}</p>",
        "validity": {
          "anchor": "after_event",
          "max_lag": "3d"
        },
        "on_stale": "skip"
      },
      {
        "id": "n4",
        "type": "wait_for_reply",
        "timeout": "24h",
        "channel": "any"
      },
      {
        "id": "n6",
        "type": "send_email",
        "subject": "Want to reschedule?",
        "template": "<p>Hey {{contact.first_name | default:there}}, one more nudge on this. If you'd like to reschedule, the link is here: {{calendar.closer_call.url}}</p><p>If the timing isn't right anymore, that's fine too.</p>",
        "validity": {
          "anchor": "after_event",
          "max_lag": "7d"
        },
        "on_stale": "skip"
      },
      {
        "id": "x1",
        "type": "exit",
        "reason": "replied"
      },
      {
        "id": "x2",
        "type": "exit",
        "reason": "no_reply"
      }
    ],
    "edges": [
      {
        "from": "t1",
        "to": "n1"
      },
      {
        "from": "t2",
        "to": "n1"
      },
      {
        "from": "n1",
        "to": "n2"
      },
      {
        "from": "n2",
        "to": "n3"
      },
      {
        "from": "n3",
        "to": "n4"
      },
      {
        "from": "n4",
        "to": "n6",
        "label": "timeout"
      },
      {
        "from": "n6",
        "to": "x2"
      },
      {
        "from": "n4",
        "to": "x1",
        "label": "replied"
      }
    ]
  }
}
