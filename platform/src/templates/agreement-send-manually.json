{
  "slug": "agreement-send-manually",
  "name": "Send agreement manually",
  "category": "agreements",
  "stage": "closing",
  "sort": 10,
  "origin": "spec",
  "description": "Sends the purchase agreement, or the one a closer picked with /agreement in Slack (agreement.requested, D202), unless the agreement is already signed: from the closer who asked (else the bound sender), stat-agreement-sent is added, the tag sys-send-agreement-manually comes off if it was the trigger, and a note records who sent which. The tag (sys-send-agreement-manually) still starts it until it is retired per offer.",
  "definition": {
    "schema": 1,
    "reentry": "always",
    "premise": {
      "check": "contact_exists"
    },
    "nodes": [
      {
        "id": "t1",
        "type": "trigger",
        "event": "tag.added",
        "match": {
          "eq": [
            "{{event.tag}}",
            "sys-send-agreement-manually"
          ]
        }
      },
      {
        "id": "t2",
        "type": "trigger",
        "event": "agreement.requested"
      },
      {
        "id": "c1",
        "type": "check",
        "when": {
          "eq": [
            "{{contact.agreement_signed}}",
            false
          ]
        },
        "else_exit": "already_signed"
      },
      {
        "id": "v_tpl",
        "type": "set_var",
        "key": "agreement_template",
        "when": {
          "exists": "event.template"
        },
        "value": "{{event.template}}",
        "else_value": "{{crm.agreement_template}}",
        "title": "Which agreement: the one picked in Slack, else the offer's"
      },
      {
        "id": "v_from",
        "type": "set_var",
        "key": "agreement_sender",
        "when": {
          "exists": "event.sender"
        },
        "value": "{{event.sender}}",
        "else_value": "{{crm.agreement_sender | default:}}",
        "title": "From the closer who asked, else the bound sender"
      },
      {
        "id": "v_name",
        "type": "set_var",
        "key": "agreement_name",
        "when": {
          "exists": "event.label"
        },
        "value": "{{event.label}}",
        "else_value": "Purchase agreement",
        "title": "Its name"
      },
      {
        "id": "v_by",
        "type": "set_var",
        "key": "sent_by",
        "when": {
          "exists": "event.by_name"
        },
        "value": "sent from Slack by {{event.by_name}}",
        "else_value": "sent manually from {{contact.owner.name | default:the team}}",
        "title": "Who sent it, for the note"
      },
      {
        "id": "d1",
        "type": "send_document",
        "template": "{{vars.agreement_template}}",
        "sender": "{{vars.agreement_sender}}",
        "name": "{{vars.agreement_name}}"
      },
      {
        "id": "g1",
        "type": "tags",
        "add": [
          "stat-agreement-sent"
        ],
        "remove": [
          "sys-send-agreement-manually"
        ]
      },
      {
        "id": "m1",
        "type": "note",
        "template": "AGREEMENT SENT — {{now | date_company}} · {{vars.agreement_name}} · {{vars.sent_by}}"
      },
      {
        "id": "x1",
        "type": "exit",
        "reason": "sent"
      }
    ],
    "edges": [
      {
        "from": "t1",
        "to": "c1"
      },
      {
        "from": "d1",
        "to": "g1"
      },
      {
        "from": "m1",
        "to": "x1"
      },
      {
        "from": "g1",
        "to": "m1"
      },
      {
        "from": "t2",
        "to": "c1"
      },
      {
        "from": "c1",
        "to": "v_tpl"
      },
      {
        "from": "v_tpl",
        "to": "v_from"
      },
      {
        "from": "v_from",
        "to": "v_name"
      },
      {
        "from": "v_name",
        "to": "v_by"
      },
      {
        "from": "v_by",
        "to": "d1"
      }
    ]
  }
}
