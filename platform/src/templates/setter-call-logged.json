{
  "slug": "setter-call-logged",
  "name": "Setter call logged",
  "category": "calls",
  "stage": "call",
  "sort": 20,
  "origin": "spec",
  "description": "The dialer logged a connected phone call and its transcript came in (the poll checks every minute, for up to the company's two hours after hang-up). A call is read as one conversation with the same setter's earlier calls to the person that started within the company's gap (15 minutes) of the last one ending: a dropped line or an accidental hang-up is one call in parts, never waited for. Conversations shorter than the minimum stop here, so do calls with no recording. Jev reads the whole conversation (each part's transcript fetched from GHL; none is stored) and decides: a setting call, a confirmation call, a closing call (handed to Sales call recorded, linked to the booked call it lines up with), or anything else (stops). A confirmation call is posted as soon as it is read. For a setting call Jev reads what it achieved, and the post goes out the moment a booking lands through a setter link (one made during the call counts at once) as Set, or 15 minutes after hang-up with Jev's read: follow up, DQ or not interested; a Set read with no booking, or a read Jev is under 70% sure of, asks the setters to tap the answer (two days). A setter-link booking that lands later, up to the company's Set window (30 minutes after hang-up), edits the post and the Discovery Call record to Set the moment it lands. A later part of the conversation edits the same post and the same record, marked as parts. The actions a result implies (a callback task, a DQ tag, the setter card lost) are built but off until the company turns them on (setter_result.act); until then the post says what they would have done. Every read is logged so Jev's accuracy can be asked for. Every call, answered or not, is kept in the recordings ledger regardless.",
  "definition": {
    "schema": 1,
    "reentry": "always",
    "premise": {
      "check": "contact_exists"
    },
    "nodes": [
      {
        "id": "t1",
        "type": "trigger",
        "event": "call.logged",
        "match": {
          "and": [
            {
              "eq": [
                "{{recording.kind}}",
                "phone"
              ]
            },
            {
              "eq": [
                "{{recording.connected}}",
                true
              ]
            }
          ]
        }
      },
      {
        "id": "v1",
        "type": "set_var",
        "key": "min_seconds",
        "value": 60
      },
      {
        "id": "l_conv",
        "type": "lookup",
        "query": "call_conversation",
        "params": {
          "recording_id": "{{recording.id}}",
          "gap_min": "{{setting.calls.conversation_gap_min}}"
        },
        "into": "convo",
        "title": "The whole conversation: the same setter's calls to them, each starting within the company's gap (15 minutes) of the last one ending"
      },
      {
        "id": "c1",
        "type": "check",
        "when": {
          "gte": [
            "{{vars.convo.total_sec}}",
            "{{vars.min_seconds}}"
          ]
        },
        "else_exit": "too_short"
      },
      {
        "id": "c2",
        "type": "check",
        "when": {
          "eq": [
            "{{recording.has_transcript}}",
            true
          ]
        },
        "else_exit": "no_transcript"
      },
      {
        "id": "a1",
        "type": "classify",
        "input": "{{vars.convo.transcript_text}}",
        "domain": "setter_call_type",
        "question": "What kind of phone call between someone on the sales team and a lead was this?",
        "criteria": {
          "setting": "The setter finds out about the lead's situation, qualifies them, and works toward booking (or books) a call with a closer.",
          "confirmation": "The setter confirms an appointment that is already booked: time, link, what to expect, perhaps a brief re-qualification.",
          "closing": "The booked sales call itself: a closer presents the program, its price or payment, handles objections and asks for a decision to buy.",
          "other": "Anything else: 'are you joining the call', 'where are you', a voicemail greeting, a wrong number, spam, a call that never got past hello, an internal or personal call, or a transcript too thin to tell."
        },
        "threshold": 0.8,
        "ambiguity_max": 0.8,
        "into": "vars.classify.call_type",
        "title": "Jev: setting, confirmation or closing call?"
      },
      {
        "id": "b_kind",
        "type": "branch",
        "title": "What kind of call?"
      },
      {
        "id": "l_book",
        "type": "lookup",
        "query": "appointments_for_contact",
        "params": {
          "kind": "closing",
          "status_not": "cancelled",
          "closer": "{{recording.caller.ghl_user_id | default:}}",
          "starts_since": "{{vars.convo.first.started_at}} -60m",
          "starts_until": "{{vars.convo.first.started_at}} +60m",
          "order": "starts_at"
        },
        "into": "closing_booking",
        "title": "Their booked call with this closer, starting within an hour of the call"
      },
      {
        "id": "v_link",
        "type": "set_var",
        "key": "booking_id",
        "value": "{{vars.closing_booking.first.id}}",
        "when": {
          "eq": [
            "{{vars.closing_booking.count}}",
            1
          ]
        },
        "else_value": "",
        "title": "Exactly one booking lines up (none or several: the closer's workflow asks which)"
      },
      {
        "id": "rec_close",
        "type": "record",
        "event": "call.closing",
        "appointment": "{{vars.booking_id}}",
        "start": true,
        "data": {
          "recording_id": "{{recording.id}}",
          "external_id": "{{recording.external_id}}",
          "conversation": "{{vars.convo.key}}",
          "parts": "{{vars.convo.count}}",
          "closer": "{{recording.caller.name | default:}}",
          "linked": "{{vars.booking_id}}"
        },
        "title": "A closing call: Sales call recorded takes it from here"
      },
      {
        "id": "x_close",
        "type": "exit",
        "reason": "closing_call"
      },
      {
        "id": "x_other",
        "type": "exit",
        "reason": "not_a_setting_call"
      },
      {
        "id": "a2",
        "type": "analyze",
        "prompt": "{{prompt.setter_call_notes}}",
        "input": "{{vars.convo.transcript_text}}",
        "into": "notes"
      },
      {
        "id": "v_parts",
        "type": "set_var",
        "key": "parts_line",
        "value": " ({{vars.convo.count}} parts)",
        "when": {
          "gt": [
            "{{vars.convo.count}}",
            1
          ]
        },
        "else_value": "",
        "title": "A call in parts says so"
      },
      {
        "id": "b_type",
        "type": "branch",
        "title": "A setting call: what did it achieve?"
      },
      {
        "id": "v_cline",
        "type": "set_var",
        "key": "outcome_line",
        "value": "Confirmation call (no result read)"
      },
      {
        "id": "a3",
        "type": "classify",
        "input": "{{vars.convo.transcript_text}}",
        "domain": "setter_call_result",
        "question": "What did this setting call between a setter and a lead achieve?",
        "criteria": {
          "set": "A call with the closer or specialist was booked on this call: a day and time were agreed, or the setter booked it while they were on the phone.",
          "follow_up": "The lead is interested but nothing was booked: a callback, a later conversation or sending them information was agreed or clearly implied.",
          "dq": "The lead does not qualify: the setter or the lead established they are not a fit (budget, age, location, medical, timeline, no real problem to solve, already with a competitor, or a bad or wrong contact).",
          "not_interested": "The lead declined: they said they are not interested, do not want a call, or asked not to be contacted."
        },
        "threshold": 0.7,
        "ambiguity_max": 0.8,
        "into": "vars.classify.result",
        "title": "Jev: set, follow up, DQ or not interested?"
      },
      {
        "id": "v_conf",
        "type": "set_var",
        "key": "jev_confidence",
        "value": "{{reply.intent_confidence}}"
      },
      {
        "id": "v_guess",
        "type": "set_var",
        "key": "jev_guesses",
        "value": "{{reply.top_guesses | words}}"
      },
      {
        "id": "w_post",
        "type": "wait_for_event",
        "event": "appointment.booked",
        "since": "{{vars.convo.first.started_at}}",
        "match": {
          "and": [
            {
              "eq": [
                "{{vars.booked.appointment.booking_source}}",
                "setter"
              ]
            },
            {
              "lte": [
                "{{vars.booked.appointment.booked_at | date:X}}",
                "{{recording.set_until | date:X}}"
              ]
            }
          ]
        },
        "into": "booked",
        "until": {
          "anchor": "recording.ended_at",
          "offset": "+15m",
          "tz": "company"
        },
        "respect_send_window": false,
        "title": "Post as soon as a booking lands through a setter link (one made during the call counts at once), else 15 minutes after hang-up"
      },
      {
        "id": "v_by",
        "type": "set_var",
        "key": "decided_by",
        "value": "jev",
        "when": {
          "in": [
            "{{vars.classify.result}}",
            [
              "follow_up",
              "dq",
              "not_interested"
            ]
          ]
        },
        "else_value": "",
        "title": "Without a booking, Jev's read (a Set read with no booking goes to the team)"
      },
      {
        "id": "v_by30",
        "type": "set_var",
        "key": "decided_by",
        "value": "booking",
        "when": {
          "eq": [
            "{{vars.booked.matched}}",
            true
          ]
        },
        "else_value": "{{vars.decided_by}}",
        "title": "A booking through a setter link: Set, whatever Jev read"
      },
      {
        "id": "v_res",
        "type": "set_var",
        "key": "result",
        "value": "{{vars.decided_by}}",
        "pick": {
          "booking": "set",
          "jev": "{{vars.classify.result}}"
        },
        "else_value": ""
      },
      {
        "id": "v_agree",
        "type": "set_var",
        "key": "jev_agreed",
        "value": true,
        "when": {
          "eq": [
            "{{vars.classify.result}}",
            "{{vars.result}}"
          ]
        },
        "else_value": false
      },
      {
        "id": "v_ask",
        "type": "set_var",
        "key": "asking",
        "value": true,
        "when": {
          "eq": [
            "{{vars.decided_by}}",
            ""
          ]
        },
        "else_value": false
      },
      {
        "id": "a4",
        "type": "classify",
        "input": "{{vars.convo.transcript_text}}",
        "domain": "setter_dq_reason",
        "only_if": {
          "in": [
            "{{vars.result}}",
            [
              "dq",
              ""
            ]
          ]
        },
        "blocking": false,
        "question": "If this lead was disqualified on the call, what was the reason?",
        "criteria": {
          "budget": "They cannot afford it or have no money for it right now.",
          "age": "They are too young or too old for the program.",
          "geo": "They are outside the area the company serves.",
          "medical": "A medical condition or treatment rules them out.",
          "timeline": "Their timing does not work: not for a long while, or no urgency at all.",
          "no_problem": "They do not actually have the problem the program solves.",
          "competitor": "They are already working with, or committed to, a competitor.",
          "bad_contact": "A wrong number, a fake or duplicate contact, or someone who never asked to be contacted.",
          "other": "Any other reason, or the transcript does not say."
        },
        "threshold": 0.6,
        "ambiguity_max": 0.8,
        "into": "vars.classify.dq_reason",
        "title": "Jev: why disqualified?"
      },
      {
        "id": "v_dqtag",
        "type": "set_var",
        "key": "dq_tag",
        "value": "{{vars.classify.dq_reason | default:}}",
        "pick": {
          "budget": "dq-budget",
          "age": "dq-age",
          "geo": "dq-geo",
          "medical": "dq-medical",
          "timeline": "dq-timeline",
          "no_problem": "dq-no-problem",
          "competitor": "dq-competitor",
          "bad_contact": "dq-bad-contact"
        },
        "else_value": "dq"
      },
      {
        "id": "rec_read",
        "type": "record",
        "event": "setter_call.result",
        "data": {
          "recording_id": "{{vars.convo.first.id}}",
          "external_id": "{{vars.convo.key}}",
          "parts": "{{vars.convo.count}}",
          "setter": "{{recording.caller.name | default:}}",
          "predicted": "{{vars.classify.result}}",
          "predicted_confidence": "{{vars.jev_confidence}}",
          "top_guesses": "{{vars.jev_guesses}}",
          "result": "{{vars.result}}",
          "decided_by": "{{vars.decided_by}}",
          "set_by_booking": "{{vars.booked.matched | default:false}}",
          "booked_at": "{{vars.booked.appointment.booked_at | default:}}",
          "jev_agreed": "{{vars.jev_agreed}}",
          "dq_reason": "{{vars.classify.dq_reason | default:}}",
          "acts": "{{setting.setter_result.act}}"
        },
        "title": "Log Jev's read, to score it later"
      },
      {
        "id": "v_due",
        "type": "set_var",
        "key": "task_due",
        "value": "{{now | date_company:c}}",
        "pick": {
          "5": "+3d",
          "6": "+2d"
        },
        "else_value": "+1d",
        "title": "Next business day"
      },
      {
        "id": "v_mode",
        "type": "set_var",
        "key": "act_word",
        "value": "*Next:*",
        "when": {
          "eq": [
            "{{setting.setter_result.act}}",
            true
          ]
        },
        "else_value": "*Would have (actions are off):*"
      },
      {
        "id": "v_key",
        "type": "set_var",
        "key": "result_key",
        "value": "{{vars.result}}",
        "pick": {
          "set": "{{picklist.discovery_call_result.set}}",
          "follow_up": "{{picklist.discovery_call_result.follow_up}}",
          "dq": "{{picklist.discovery_call_result.dq}}",
          "not_interested": "{{picklist.discovery_call_result.not_interested}}"
        },
        "else_value": ""
      },
      {
        "id": "v_words",
        "type": "set_var",
        "key": "result_words",
        "value": "{{vars.result}}",
        "pick": {
          "set": "Set",
          "follow_up": "Follow up",
          "dq": "DQ",
          "not_interested": "Not interested"
        },
        "else_value": ""
      },
      {
        "id": "v_act",
        "type": "set_var",
        "key": "act_line",
        "value": "{{vars.result}}",
        "pick": {
          "follow_up": "{{vars.act_word}} a task for {{recording.caller.name | default:the setter}} to call back {{contact.name | default:them}}, due next business day.",
          "dq": "{{vars.act_word}} tag {{vars.dq_tag}} and mark the setter card lost.",
          "not_interested": "{{vars.act_word}} mark the setter card lost."
        },
        "else_value": ""
      },
      {
        "id": "v_when",
        "type": "set_var",
        "key": "booked_when",
        "value": "during the call",
        "when": {
          "lte": [
            "{{vars.booked.appointment.booked_at | date:X}}",
            "{{recording.ended_at | date:X}}"
          ]
        },
        "else_value": "after the call"
      },
      {
        "id": "v_unsure",
        "type": "set_var",
        "key": "unsure_line",
        "value": "{{vars.classify.result}}",
        "pick": {
          "set": "Jev read Set ({{vars.jev_confidence}}% sure), but no booking came through a setter link"
        },
        "else_value": "Jev isn't sure (its guesses: {{vars.jev_guesses}})"
      },
      {
        "id": "v_line",
        "type": "set_var",
        "key": "outcome_line",
        "value": "{{vars.decided_by}}",
        "pick": {
          "booking": "Set — booked through a setter link {{vars.booked_when}} (Jev read: {{vars.classify.result | words}}, {{vars.jev_confidence}}% sure)",
          "jev": "{{vars.result_words}} (Jev is {{vars.jev_confidence}}% sure)"
        },
        "else_value": "{{vars.unsure_line}}; the team is asked"
      },
      {
        "id": "l_now",
        "type": "lookup",
        "query": "call_conversation",
        "params": {
          "recording_id": "{{recording.id}}",
          "gap_min": "{{setting.calls.conversation_gap_min}}"
        },
        "into": "convo_now",
        "title": "Has a later part of this conversation come in meanwhile?"
      },
      {
        "id": "c_latest",
        "type": "check",
        "when": {
          "eq": [
            "{{vars.convo_now.later_ready}}",
            0
          ]
        },
        "else_exit": "read_with_a_later_part"
      },
      {
        "id": "r1",
        "type": "crm_record",
        "object": "custom_objects.discovery_call",
        "key": "{{vars.convo.key}}",
        "owner": "{{recording.caller.ghl_user_id | default:}}",
        "properties": {
          "display_label": "{{contact.name | default:Unknown}} — {{vars.convo.first.started_at | date_company}}{{vars.parts_line}}",
          "external_id": "{{vars.convo.key}}",
          "contact_id": "{{contact.ghl_contact_id | default:}}",
          "occurred_at": "{{vars.convo.first.started_at | date_company}}",
          "direction": "{{recording.direction}}",
          "duration_sec": "{{vars.convo.total_sec}}",
          "setter": "{{recording.caller.name | default:}}",
          "outcome": "{{recording.status}}",
          "recording_url": "{{recording.url | default:}}",
          "call_result": "{{vars.result_key | default:}}"
        },
        "relate": [
          {
            "association": "{{crm.assoc_discovery_call_contact}}",
            "first": "{{contact.ghl_contact_id | default:}}",
            "second": "{{record.id}}"
          }
        ],
        "title": "The Discovery Call record (one per conversation)"
      },
      {
        "id": "m1",
        "type": "note",
        "template": "SETTER CALL — {{vars.convo.first.started_at | date_company}} · {{recording.caller.name | default:setter unknown}} · {{vars.classify.call_type}} · {{vars.convo.total_min}} min{{vars.parts_line}}\n\n{{vars.notes.digest}}\n\nOutcome: {{vars.outcome_line}}"
      },
      {
        "id": "s1",
        "type": "slack_post",
        "channel": "{{slack.channel.setter_calls}}",
        "template": "*Setter call with:* <https://app.gohighlevel.com/v2/location/{{crm.location_id}}/contacts/detail/{{contact.ghl_contact_id | default:}}|{{contact.name | default:Unknown}}> · {{vars.classify.call_type}}\n*Setter:* {{recording.caller.name | default:unknown}} · *Length:* {{vars.convo.total_min}} min{{vars.parts_line}} · {{recording.direction}}\n*Outcome:* {{vars.outcome_line}}{{vars.act_line | line}}\n\n{{vars.notes.digest}}\n\n<{{recording.share_url | default:}}|Open the conversation in GHL>",
        "as": {
          "name": "Setter call",
          "icon": [
            ":telephone_receiver:",
            ":speech_balloon:",
            ":headphones:"
          ]
        },
        "tag": "setter-call:{{vars.convo.key}}",
        "edit": true,
        "title": "Post the setter call in Slack (a later part edits the same post)"
      },
      {
        "id": "w_late",
        "type": "wait_for_event",
        "event": "appointment.booked",
        "since": "{{vars.convo.first.started_at}}",
        "match": {
          "and": [
            {
              "eq": [
                "{{vars.late.appointment.booking_source}}",
                "setter"
              ]
            },
            {
              "lte": [
                "{{vars.late.appointment.booked_at | date:X}}",
                "{{recording.set_until | date:X}}"
              ]
            }
          ]
        },
        "into": "late",
        "only_if": {
          "and": [
            {
              "eq": [
                "{{vars.classify.call_type}}",
                "setting"
              ]
            },
            {
              "neq": [
                "{{vars.result}}",
                "set"
              ]
            }
          ]
        },
        "until": {
          "anchor": "recording.set_until",
          "offset": "+0m",
          "tz": "company"
        },
        "respect_send_window": false,
        "title": "Until the Set window closes (the company's 30 minutes after hang-up): a booking through a setter link makes it Set"
      },
      {
        "id": "l_now2",
        "type": "lookup",
        "query": "call_conversation",
        "params": {
          "recording_id": "{{recording.id}}",
          "gap_min": "{{setting.calls.conversation_gap_min}}"
        },
        "into": "convo_now",
        "title": "Has a later part of this conversation come in meanwhile?"
      },
      {
        "id": "c_latest2",
        "type": "check",
        "when": {
          "eq": [
            "{{vars.convo_now.later_ready}}",
            0
          ]
        },
        "else_exit": "read_with_a_later_part",
        "title": "A later part's run has the whole conversation (its post, its record, its question)"
      },
      {
        "id": "b_late",
        "type": "branch",
        "title": "Did a booking through a setter link land in the Set window?"
      },
      {
        "id": "lt_res",
        "type": "set_var",
        "key": "result",
        "value": "set"
      },
      {
        "id": "lt_by",
        "type": "set_var",
        "key": "decided_by",
        "value": "booking"
      },
      {
        "id": "lt_agree",
        "type": "set_var",
        "key": "jev_agreed",
        "value": true,
        "when": {
          "eq": [
            "{{vars.classify.result}}",
            "set"
          ]
        },
        "else_value": false
      },
      {
        "id": "lt_ask",
        "type": "set_var",
        "key": "asking",
        "value": false
      },
      {
        "id": "lt_key",
        "type": "set_var",
        "key": "result_key",
        "value": "{{picklist.discovery_call_result.set}}"
      },
      {
        "id": "lt_words",
        "type": "set_var",
        "key": "result_words",
        "value": "Set"
      },
      {
        "id": "lt_act",
        "type": "set_var",
        "key": "act_line",
        "value": ""
      },
      {
        "id": "lt_line",
        "type": "set_var",
        "key": "outcome_line",
        "value": "Set — booked through a setter link after the call (Jev read: {{vars.classify.result | words}}, {{vars.jev_confidence}}% sure)"
      },
      {
        "id": "rec_late",
        "type": "record",
        "event": "setter_call.result",
        "data": {
          "recording_id": "{{vars.convo.first.id}}",
          "external_id": "{{vars.convo.key}}",
          "parts": "{{vars.convo.count}}",
          "setter": "{{recording.caller.name | default:}}",
          "predicted": "{{vars.classify.result}}",
          "predicted_confidence": "{{vars.jev_confidence}}",
          "top_guesses": "{{vars.jev_guesses}}",
          "result": "set",
          "decided_by": "booking",
          "set_by_booking": "true",
          "booked_at": "{{vars.late.appointment.booked_at | default:}}",
          "jev_agreed": "{{vars.jev_agreed}}",
          "dq_reason": "{{vars.classify.dq_reason | default:}}",
          "acts": "{{setting.setter_result.act}}"
        },
        "title": "Log the result again: Set by the booking"
      },
      {
        "id": "r_late",
        "type": "crm_record",
        "object": "custom_objects.discovery_call",
        "key": "{{vars.convo.key}}",
        "if_missing": "skip",
        "properties": {
          "call_result": "{{vars.result_key}}"
        },
        "title": "The Discovery Call record becomes Set"
      },
      {
        "id": "s_late",
        "type": "slack_post",
        "channel": "{{slack.channel.setter_calls}}",
        "template": "*Setter call with:* <https://app.gohighlevel.com/v2/location/{{crm.location_id}}/contacts/detail/{{contact.ghl_contact_id | default:}}|{{contact.name | default:Unknown}}> · {{vars.classify.call_type}}\n*Setter:* {{recording.caller.name | default:unknown}} · *Length:* {{vars.convo.total_min}} min{{vars.parts_line}} · {{recording.direction}}\n*Outcome:* {{vars.outcome_line}}{{vars.act_line | line}}\n\n{{vars.notes.digest}}\n\n<{{recording.share_url | default:}}|Open the conversation in GHL>",
        "as": {
          "name": "Setter call",
          "icon": [
            ":telephone_receiver:",
            ":speech_balloon:",
            ":headphones:"
          ]
        },
        "tag": "setter-call:{{vars.convo.key}}",
        "edit": true,
        "title": "Edit the post to Set"
      },
      {
        "id": "b_ask",
        "type": "branch",
        "title": "Was Jev sure?"
      },
      {
        "id": "q1",
        "type": "slack_post",
        "channel": "{{slack.channel.setter_calls}}",
        "fallback_channel": [
          "{{slack.channel.ops}}",
          "{{slack.channel.bookings}}"
        ],
        "as": {
          "name": "Set, follow up or DQ?",
          "icon": ":grey_question:"
        },
        "template": "{{recording.caller.name | default:The setter}}'s call with <https://app.gohighlevel.com/v2/location/{{crm.location_id}}/contacts/detail/{{contact.ghl_contact_id | default:}}|{{contact.name | default:Unknown}}> ({{vars.convo.first.started_at | date_company}}{{vars.parts_line}}): what did it achieve? {{vars.unsure_line | default:}}.\nTap ✅ Set · 🔁 Follow up · ❌ DQ · 🚫 Not interested. Nothing is written until someone does; the question closes in two days.",
        "tag": "setter-result:{{vars.convo.key}}",
        "offer": [
          "white_check_mark",
          "repeat",
          "x",
          "no_entry_sign"
        ],
        "title": "Ask the setters: set, follow up, DQ or not interested?"
      },
      {
        "id": "l1",
        "type": "wait_for_reaction",
        "of": "tag:setter-result:{{vars.convo.key}}",
        "emojis": [
          "white_check_mark",
          "repeat",
          "x",
          "no_entry_sign"
        ],
        "blocking": false,
        "until": {
          "anchor": "now",
          "offset": "+2d",
          "tz": "company"
        },
        "title": "Listen for the tap for two days"
      },
      {
        "id": "w_hold",
        "type": "wait",
        "rule": {
          "anchor": "now",
          "offset": "+2d",
          "tz": "company"
        },
        "only_if": {
          "and": [
            {
              "eq": [
                "{{vars.asking}}",
                true
              ]
            },
            {
              "exists": "vars.__listen"
            }
          ]
        },
        "title": "Keep the question open two days"
      },
      {
        "id": "tv_res",
        "type": "set_var",
        "key": "result",
        "value": "{{reaction.reaction | default:}}",
        "pick": {
          "white_check_mark": "set",
          "repeat": "follow_up",
          "x": "dq",
          "no_entry_sign": "not_interested"
        },
        "else_value": ""
      },
      {
        "id": "tv_by",
        "type": "set_var",
        "key": "decided_by",
        "value": "human"
      },
      {
        "id": "tv_agree",
        "type": "set_var",
        "key": "jev_agreed",
        "value": true,
        "when": {
          "eq": [
            "{{vars.classify.result}}",
            "{{vars.result}}"
          ]
        },
        "else_value": false
      },
      {
        "id": "tv_ask",
        "type": "set_var",
        "key": "asking",
        "value": false
      },
      {
        "id": "rec_rev",
        "type": "record",
        "event": "intent.reviewed",
        "data": {
          "domain": "setter_call_result",
          "predicted": "{{vars.classify.result}}",
          "predicted_confidence": "{{vars.jev_confidence}}",
          "decided": "{{vars.result}}",
          "agreed": "{{vars.jev_agreed}}",
          "decided_by": "{{reaction.user_name}}",
          "recording_id": "{{vars.convo.first.id}}"
        },
        "title": "Score Jev: what the team said the call achieved"
      },
      {
        "id": "tv_key",
        "type": "set_var",
        "key": "result_key",
        "value": "{{vars.result}}",
        "pick": {
          "set": "{{picklist.discovery_call_result.set}}",
          "follow_up": "{{picklist.discovery_call_result.follow_up}}",
          "dq": "{{picklist.discovery_call_result.dq}}",
          "not_interested": "{{picklist.discovery_call_result.not_interested}}"
        },
        "else_value": ""
      },
      {
        "id": "tv_words",
        "type": "set_var",
        "key": "result_words",
        "value": "{{vars.result}}",
        "pick": {
          "set": "Set",
          "follow_up": "Follow up",
          "dq": "DQ",
          "not_interested": "Not interested"
        },
        "else_value": ""
      },
      {
        "id": "tv_act",
        "type": "set_var",
        "key": "act_line",
        "value": "{{vars.result}}",
        "pick": {
          "follow_up": "{{vars.act_word}} a task for {{recording.caller.name | default:the setter}} to call back {{contact.name | default:them}}, due next business day.",
          "dq": "{{vars.act_word}} tag {{vars.dq_tag}} and mark the setter card lost.",
          "not_interested": "{{vars.act_word}} mark the setter card lost."
        },
        "else_value": ""
      },
      {
        "id": "rs",
        "type": "resume",
        "title": "Back to where the run was"
      },
      {
        "id": "ru1",
        "type": "record",
        "event": "intent.unanswered",
        "data": {
          "domain": "setter_call_result",
          "predicted": "{{vars.classify.result}}",
          "predicted_confidence": "{{vars.jev_confidence}}",
          "top_guesses": "{{vars.jev_guesses}}",
          "recording_id": "{{vars.convo.first.id}}"
        },
        "title": "Record that nobody answered in two days"
      },
      {
        "id": "ru2",
        "type": "slack_post",
        "channel": "{{slack.channel.setter_calls}}",
