              "eq": [
                "{{vars.result}}",
                "dq"
              ]
            }
          ]
        },
        "add": [
          "{{vars.dq_tag}}"
        ]
      },
      {
        "id": "k_lost_dq",
        "type": "pipeline_card",
        "only_if": {
          "and": [
