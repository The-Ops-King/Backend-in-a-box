        "fallback_channel": [
          "{{slack.channel.ops}}",
          "{{slack.channel.bookings}}"
        ],
        "thread_of": "tag:setter-result:{{vars.convo.key}}",
        "thread_only": true,
        "only_if": {
          "eq": [
            "{{vars.decided_by}}",
            "human"
          ]
        },
        "as": {
          "name": "Set, follow up or DQ?",
          "icon": ":grey_question:"
        },
        "template": "{{vars.result_words}}, per {{reaction.user_name | default:the team}}.{{vars.act_line | line}}",
        "unreact": {
          "of": "tag:setter-result:{{vars.convo.key}}",
          "emojis": [
            "white_check_mark",
            "repeat",
            "x",
            "no_entry_sign"
          ]
        },
        "title": "Say who decided, in the question's thread"
      },
      {
        "id": "k_task",
        "type": "create_task",
        "only_if": {
          "and": [
            {
              "eq": [
                "{{setting.setter_result.act}}",
                true
              ]
            },
            {
              "eq": [
                "{{vars.result}}",
                "follow_up"
              ]
            }
          ]
        },
        "title": "Call back {{contact.name | default:the lead}}",
        "body": "Follow-up from {{recording.caller.name | default:the setter}}'s call on {{vars.convo.first.started_at | date_company}}.\nSuggested next step: {{vars.notes.next_step | default:—}}\n\n{{vars.notes.digest | default:}}",
        "due": "{{vars.task_due}}",
        "assign_to": "{{recording.caller.ghl_user_id | default:}}"
