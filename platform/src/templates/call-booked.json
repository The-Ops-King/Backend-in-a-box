{
  "slug": "call-booked",
  "name": "Call booked",
  "category": "booking",
  "stage": "booking",
  "sort": 10,
  "origin": "spec",
  "description": "A closing call is booked (or moved): the contact gets the appointment date and the closer as owner, the setter card moves to Direct Booked Call or Appointment Set, the closer card is created or moved to Scheduled, stat-booked plus stat-self-booked or stat-set are added, the nurture sequence tags and opt-in lead come off along with stat-no-show, stat-cancelled, stat-possible-cancel and stat-needs-attention (a fresh booking resets them so a filter on them does not catch someone who has rebooked, D62), meta booked call goes on, the owner gets a task to send a personal video, the Sales Call record is created (the recording updates it later; a reschedule moves it), and the team gets the Slack card with the intake answers. A reschedule runs the same CRM updates but posts no new card: it reacts 🔁 on the booking post and puts the new time in its thread.",
  "definition": {
    "schema": 1,
    "reentry": "always",
    "premise": {
      "check": "appointment_exists"
    },
    "nodes": [
      {
        "id": "t1",
        "type": "trigger",
        "event": "appointment.booked",
        "match": {
          "eq": [
            "{{appointment.term.category}}",
            "closing"
          ]
        }
      },
      {
        "id": "t2",
        "type": "trigger",
        "event": "appointment.rescheduled",
        "match": {
          "eq": [
            "{{appointment.term.category}}",
            "closing"
          ]
        }
      },
      {
        "id": "n1",
        "type": "update_contact",
        "set": {
          "assign_to": "{{appointment.closer.ghl_user_id | default:}}"
        },
        "fields": [
          {
            "id": "{{crm.field_contact_appointment_date}}",
            "value": "{{appointment.starts_at | date_company:yyyy-MM-dd}}"
          }
        ]
      },
      {
        "id": "n2",
        "type": "branch"
      },
      {
        "id": "s1",
        "type": "set_var",
        "key": "setter_line",
        "value": ""
      },
      {
        "id": "s2",
        "type": "set_var",
        "key": "booking_kind",
        "value": "self-booked"
      },
      {
        "id": "s3",
        "type": "pipeline_card",
        "pipeline": "{{crm.pipeline_setter}}",
        "stage": "{{crm.stage_setter_direct_booked}}",
        "name": "{{contact.name}} -- Direct",
        "assign_to": "{{appointment.closer.ghl_user_id | default:}}"
      },
      {
        "id": "s4",
        "type": "pipeline_card",
        "pipeline": "{{crm.pipeline_closer}}",
        "stage": "{{crm.stage_closer_scheduled}}",
        "name": "{{contact.name}} -- Direct",
        "assign_to": "{{appointment.closer.ghl_user_id | default:}}"
      },
      {
        "id": "s5",
        "type": "tags",
        "add": [
          "stat-booked",
          "stat-self-booked",
          "meta booked call"
        ],
        "remove": [
          "seq-no-show",
          "seq-nurture",
          "seq-winback",
          "opt-in lead",
          "stat-no-show",
          "stat-cancelled",
          "stat-possible-cancel",
          "stat-needs-attention"
        ]
      },
      {
        "id": "b1",
        "type": "set_var",
        "key": "setter_line",
        "value": "*Setter:* {{appointment.set_by | default:unknown}}"
      },
      {
        "id": "b2",
        "type": "set_var",
        "key": "booking_kind",
        "value": "setter booked"
      },
      {
        "id": "b3",
        "type": "update_contact",
        "fields": [
          {
            "id": "{{crm.field_contact_setter}}",
            "value": "{{appointment.set_by | default:}}"
          }
        ]
      },
      {
        "id": "b4",
        "type": "pipeline_card",
        "pipeline": "{{crm.pipeline_setter}}",
        "stage": "{{crm.stage_setter_appointment_set}}",
        "name": "{{contact.name}} -- Set",
        "assign_to": "{{appointment.closer.ghl_user_id | default:}}",
        "fields": [
          {
            "id": "{{crm.field_opportunity_setter_owner}}",
            "value": "{{appointment.set_by | default:}}"
          }
        ]
      },
      {
        "id": "b5",
        "type": "pipeline_card",
        "pipeline": "{{crm.pipeline_closer}}",
        "stage": "{{crm.stage_closer_scheduled}}",
        "name": "{{contact.name}} -- Setter Booked",
        "assign_to": "{{appointment.closer.ghl_user_id | default:}}",
        "fields": [
          {
            "id": "{{crm.field_opportunity_setter_owner}}",
            "value": "{{appointment.set_by | default:}}"
          }
        ]
      },
      {
        "id": "b6",
        "type": "tags",
        "add": [
          "stat-booked",
          "stat-set",
          "meta booked call"
        ],
        "remove": [
          "seq-no-show",
          "seq-nurture",
          "seq-winback",
          "opt-in lead",
          "stat-no-show",
          "stat-cancelled",
          "stat-possible-cancel",
          "stat-needs-attention"
        ]
      },
      {
        "id": "k3",
        "type": "create_task",
        "title": "Send {{contact.first_name}} a personalized video",
        "body": "Booked for {{appointment.starts_at | date_company}}. A quick personal video before the call.",
        "due": "+1d",
        "assign_to": "{{appointment.closer.ghl_user_id | default:}}",
        "only_if": {
          "neq": [
            "{{event._type}}",
            "appointment.rescheduled"
          ]
        }
      },
      {
        "id": "k4",
        "type": "crm_record",
        "object": "custom_objects.sales_call",
        "key": "{{appointment.external_id}}",
        "properties": {
          "display_label": "{{contact.name | default:Unknown}} — {{appointment.starts_at | date_company:yyyy-MM-dd}}",
          "external_id": "{{appointment.external_id}}",
          "contact_id": "{{contact.ghl_contact_id | default:}}",
          "opportunity_id": "{{cards.closer.id | default:}}",
          "scheduled_at": "{{appointment.starts_at}}",
          "call_date": "{{appointment.starts_at | date_company:yyyy-MM-dd}}",
          "closer": "{{appointment.closer.name | default:}}",
          "setter": "{{appointment.set_by | default:}}",
          "outcome": "scheduled"
        },
        "relate": [
          {
            "association": "{{crm.assoc_sales_call_contact}}",
            "first": "{{contact.ghl_contact_id | default:}}",
            "second": "{{record.id}}"
          },
          {
            "association": "{{crm.assoc_sales_call_opportunity}}",
            "first": "{{record.id}}",
            "second": "{{cards.closer.id | default:}}"
          }
        ]
      },
      {
        "id": "n4",
        "type": "slack_post",
        "channel": "{{slack.channel.bookings}}",
        "template": "*Name:* <https://app.gohighlevel.com/v2/location/{{crm.location_id}}/contacts/detail/{{contact.ghl_contact_id | default:}}|{{contact.name | default:Unknown}}>\n*Booked with:* {{appointment.closer.name | default:unassigned}}\n{{vars.setter_line}}\n*Appointment time:* {{appointment.starts_at | date_company}}\n*Phone:* {{contact.phone | default:—}}\n*Hair loss:* {{contact.fields.hair_loss | default:—}} {{contact.fields.hair_loss_stage | default:}}\n*Noticing for:* {{contact.fields.noticing_for | default:—}}\n*Commit to routine:* {{contact.fields.commit_routine | default:—}}\n*Work situation:* {{contact.fields.work_situation | default:—}}\n*Reschedule link:* {{appointment.reschedule_url | default:—}}\n*Source:* {{appointment.tracking.utm_source | default:—}} · {{vars.booking_kind}}",
        "as": {
          "name": "New call booked",
          "icon": [
            ":telephone_receiver:",
            ":calendar:",
            ":date:",
            ":spiral_calendar_pad:"
          ]
        },
        "title": "Post booking card in Slack",
        "tag": "appointment:{{appointment.id}}",
        "only_if": {
          "neq": [
            "{{event._type}}",
            "appointment.rescheduled"
          ]
        }
      },
      {
        "id": "n4r",
        "type": "slack_post",
        "only_if": {
          "eq": [
            "{{event._type}}",
            "appointment.rescheduled"
          ]
        },
        "channel": "{{slack.channel.bookings}}",
        "thread_of": "tag:appointment:{{appointment.id}}",
        "react": "repeat",
        "as": {
          "name": "Rescheduled",
          "icon": ":repeat:"
        },
        "template": "🔁 Rescheduled to {{appointment.starts_at | date_company}} with {{appointment.closer.name | default:unassigned}}.",
        "title": "React 🔁, new time in the thread"
      },
      {
        "id": "x1",
        "type": "exit",
        "reason": "booked"
      }
    ],
    "edges": [
      {
        "from": "t1",
        "to": "n1"
      },
      {
        "from": "t2",
        "to": "n1"
      },
      {
        "from": "n1",
        "to": "n2"
      },
      {
        "from": "n2",
        "to": "b1",
        "when": {
          "eq": [
            "{{appointment.self_booked}}",
            false
          ]
        },
        "label": "setter booked"
      },
      {
        "from": "n2",
        "to": "s1",
        "else": true,
        "label": "self-booked"
      },
      {
        "from": "s1",
        "to": "s2"
      },
      {
        "from": "s2",
        "to": "s3"
      },
      {
        "from": "s3",
        "to": "s4"
      },
      {
        "from": "s4",
        "to": "s5"
      },
      {
        "from": "b1",
        "to": "b2"
      },
      {
        "from": "b2",
        "to": "b3"
      },
      {
        "from": "b3",
        "to": "b4"
      },
      {
        "from": "b4",
        "to": "b5"
      },
      {
        "from": "b5",
        "to": "b6"
      },
      {
        "from": "n4",
        "to": "n4r"
      },
      {
        "from": "k3",
        "to": "k4"
      },
      {
        "from": "k4",
        "to": "n4"
      },
      {
        "from": "n4r",
        "to": "x1"
      },
      {
        "from": "s5",
        "to": "k3"
      },
      {
        "from": "b6",
        "to": "k3"
      }
    ]
  }
}
