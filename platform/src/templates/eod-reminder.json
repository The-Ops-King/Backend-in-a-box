{
  "slug": "eod-reminder",
  "name": "EOD: remind closers to file",
  "category": "team",
  "stage": "team",
  "sort": 10,
  "origin": "spec",
  "description": "DMs each closer their end-of-day link at 6 PM, and again at 9 AM, until every call is filed; tells you when a call is still blank after 2 days.",
  "definition": {
    "schema": 1,
    "reentry": "always",
    "premise": {
      "check": "none"
    },
    "nodes": [
      {
        "id": "t_evening",
        "type": "trigger",
        "event": "schedule",
        "schedule": {
          "at": "18:00",
          "for": "closer"
        }
      },
      {
        "id": "t_morning",
        "type": "trigger",
        "event": "schedule",
        "schedule": {
          "at": "09:00",
          "for": "closer"
        }
      },
      {
        "id": "v_evening",
        "type": "eod_due",
        "period": "evening",
        "into": "due",
        "title": "Today and every earlier day still to file (the ledger and GHL's Sales Calls)",
        "lookback_days": 7,
        "include_today": true,
        "overdue_after_days": 2
      },
      {
        "id": "v_morning",
        "type": "eod_due",
        "period": "morning",
        "into": "due",
        "title": "Every earlier day still to file",
        "lookback_days": 7,
        "include_today": false,
        "overdue_after_days": null
      },
      {
        "id": "c_due",
        "type": "check",
        "when": {
          "gt": [
            "{{vars.due.count}}",
            0
          ]
        },
        "else_exit": "nothing_to_file"
      },
      {
        "id": "n_dm",
        "type": "slack_post",
        "channel": "{{user.slack_user_id}}",
        "as": {
          "name": "End of day",
          "icon": ":clipboard:"
        },
        "tag": "eod-reminder:{{user.id}}:{{user.eod.day}}",
        "template": "Hey {{user.first_name}}, your end-of-day is waiting:\n{{vars.due.days | each:\"• <{{item.url}}|{{item.when}}>: {{item.calls | nonzero | plural:call}}{{item.both | then:\\\", \\\"}}{{item.ghl_blank | nonzero | plural:call | suffix:\\\" with no outcome in GHL\\\"}}\" | join:\"\\n\"}}\nIt's prefilled from your calendar and the day's calls. Fix anything that's off and hit submit.",
        "title": "DM the closer their link"
      },
      {
        "id": "n_op",
        "type": "slack_post",
        "channel": "{{company.operator_slack_id}}",
        "only_if": {
          "and": [
            {
              "exists": "company.operator_slack_id"
            },
            {
              "gt": [
                "{{vars.due.overdue_count}}",
                0
              ]
            }
          ]
        },
        "as": {
          "name": "End of day",
          "icon": ":clipboard:"
        },
        "template": "{{user.name}} still has calls with no outcome after two days:\n{{vars.due.overdue | each:\"• <{{item.url}}|{{item.label}}>: {{item.names | join}}\" | join:\"\\n\"}}\nOpen a day to file it yourself.",
        "title": "Tell the operator about calls blank for two days"
      },
      {
        "id": "x_done",
        "type": "exit",
        "reason": "done"
      },
      {
        "id": "x_nothing",
        "type": "exit",
        "reason": "nothing_to_file"
      }
    ],
    "edges": [
      {
        "from": "t_evening",
        "to": "v_evening"
      },
      {
        "from": "t_morning",
        "to": "v_morning"
      },
      {
        "from": "v_evening",
        "to": "c_due"
      },
      {
        "from": "v_morning",
        "to": "c_due"
      },
      {
        "from": "c_due",
        "to": "n_dm"
      },
      {
        "from": "n_dm",
        "to": "n_op"
      },
      {
        "from": "n_op",
        "to": "x_done"
      }
    ]
  }
}
