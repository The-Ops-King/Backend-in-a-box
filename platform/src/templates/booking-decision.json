{
  "slug": "booking-decision",
  "name": "Booking decided in Slack",
  "category": "booking",
  "stage": "pre_call",
  "sort": 6,
  "origin": "spec",
  "description": "When the engine could not read a prospect's reply it asks the team in the booking thread with ✅ and ❌ to tap. A tap is an event: ✅ marks the call confirmed (tag, reminders go on), ❌ cancels it (the cancellation flow takes it from there). Either way the engine notes who decided in the thread, reacts on the booking post, and takes its own ✅ ❌ off the question so only the person's tap is left (D45).",
  "definition": {
    "schema": 1,
    "reentry": "always",
    "nodes": [
      {
        "id": "t1",
        "type": "trigger",
        "event": "slack.reaction",
        "match": {
          "and": [
            {
              "eq": [
                "{{event.kind}}",
                "decision"
              ]
            },
            {
              "in": [
                "{{event.reaction}}",
                [
                  "white_check_mark",
                  "x"
                ]
              ]
            }
          ]
        }
      },
      {
        "id": "b1",
        "type": "branch"
      },
      {
        "id": "y1",
        "type": "set_tag",
        "tag": "confirmed"
      },
      {
        "id": "y2",
        "type": "remove_tag",
        "tag": "unconfirmed"
      },
      {
        "id": "y3",
        "type": "slack_post",
        "channel": "{{slack.channel.bookings}}",
        "thread_of": "tag:appointment:{{appointment.id}}",
        "thread_only": true,
        "react": "white_check_mark",
        "unreact": {
          "of": "tag:decision:{{appointment.id}}",
          "emojis": [
            "white_check_mark",
            "x"
          ]
        },
        "as": {
          "name": "Confirmed",
          "icon": ":white_check_mark:"
        },
        "template": "✅ Confirmed by {{event.user_name}}.",
        "title": "React ✅, note who confirmed"
      },
      {
        "id": "n1",
        "type": "update_appointment",
        "set": {
          "status": "cancelled"
        }
      },
      {
        "id": "n2",
        "type": "slack_post",
        "channel": "{{slack.channel.bookings}}",
        "thread_of": "tag:appointment:{{appointment.id}}",
        "thread_only": true,
        "react": "x",
        "unreact": {
          "of": "tag:decision:{{appointment.id}}",
          "emojis": [
            "white_check_mark",
            "x"
          ]
        },
        "as": {
          "name": "Call cancelled",
          "icon": ":x:"
        },
        "template": "❌ Cancelled by {{event.user_name}}.",
        "title": "React ❌, note who cancelled"
      },
      {
        "id": "x1",
        "type": "exit",
        "reason": "decided"
      }
    ],
    "edges": [
      {
        "from": "t1",
        "to": "b1"
      },
      {
        "from": "b1",
        "to": "y1",
        "when": {
          "eq": [
            "{{event.reaction}}",
            "white_check_mark"
          ]
        },
        "label": "✅ confirmed"
      },
      {
        "from": "b1",
        "to": "n1",
        "else": true,
        "label": "❌ cancel"
      },
      {
        "from": "y1",
        "to": "y2"
      },
      {
        "from": "y2",
        "to": "y3"
      },
      {
        "from": "y3",
        "to": "x1"
      },
      {
        "from": "n1",
        "to": "n2"
      },
      {
        "from": "n2",
        "to": "x1"
      }
    ]
  }
}
