{
  "slug": "agreement-signed",
  "name": "Agreement signed",
  "category": "agreements",
  "stage": "closing",
  "sort": 20,
  "origin": "spec",
  "description": "The signer completed the purchase agreement (the engine watches the CRM's documents): stat-agreement-signed is added and stat-agreement-unsigned comes off (a signed client must not carry the chase's tag, D62), a dated note goes on the contact, and the team sees it in Slack with what has been paid so far. Deal closed takes it from here when payment is also in.",
  "definition": {
    "schema": 1,
    "reentry": "always",
    "premise": {
      "check": "contact_exists"
    },
    "nodes": [
      {
        "id": "t1",
        "type": "trigger",
        "event": "agreement.signed"
      },
      {
        "id": "g1",
        "type": "tags",
        "add": [
          "stat-agreement-signed"
        ],
        "remove": [
          "stat-agreement-unsigned"
        ]
      },
      {
        "id": "m1",
        "type": "note",
        "template": "AGREEMENT SIGNED — {{agreement.signed_at | date_company}} · {{agreement.name | default:agreement}}"
      },
      {
        "id": "s1",
        "type": "slack_post",
        "channel": "{{slack.channel.deals}}",
        "template": "*Agreement signed:*\n*Name:* <https://app.gohighlevel.com/v2/location/{{crm.location_id}}/contacts/detail/{{contact.ghl_contact_id | default:}}|{{contact.name | default:Unknown}}>",
        "as": {
          "name": "Agreement signed",
          "icon": [
            ":memo:",
            ":pencil:",
            ":page_with_curl:",
            ":fountain_pen:"
          ]
        },
        "title": "Post signed agreement in Slack"
      },
      {
        "id": "x1",
        "type": "exit",
        "reason": "recorded"
      }
    ],
    "edges": [
      {
        "from": "t1",
        "to": "g1"
      },
      {
        "from": "g1",
        "to": "m1"
      },
      {
        "from": "m1",
        "to": "s1"
      },
      {
        "from": "s1",
        "to": "x1"
      }
    ]
  }
}
