{
  "slug": "call-outcome",
  "name": "Call outcome filed",
  "category": "post_call",
  "stage": "post_call",
  "sort": 4,
  "origin": "spec",
  "description": "A closer filed how a call went (the end-of-day form, the disposition form) or the CRM marked it a no-show: the booking post in Slack gets the reaction and a line in its thread, the contact gets the outcome tags, and the pipeline cards follow the call (D61). No-show → 👻, stat-no-show, the setter card to No-Show / Cancel / Reschedule, lost (the setter pipeline is won on a show, lost on a no-show; a rebook makes a fresh setter card) and the closer card to No Show / Cancelled, still open (a rebook reuses it). Showed → ✅ (Sales call recorded puts its own ✅ when the recording lands; this one makes sure it is there, never a second one), stat-showed and the setter card to Showed, won (a no-op when the recording already moved it), then the call outcome the closer confirmed: closed or deposit → stat-closed-won (the closer card waits for Deal closed / Payment recorded: Agreement Sent, Closed - Won), follow-up → stat-follow-up and the closer card to Follow Up, lost → stat-lost and the closer card to Lost (lost), disqualified → stat-disqualified and the closer card to Disqualified (lost). Every card step moves a card that exists and never makes one (a contact booked before the engine may have none). A reschedule changes nothing here: Call booked already reacted 🔁. The Sales Call record (created at booking) is updated with the outcome and, for a show, the disposition the closer confirmed. Jev's read of the transcript only pre-fills the form; the tags come from the closer's answer (D50, D54).",
  "definition": {
    "schema": 1,
    "reentry": "always",
    "premise": {
      "check": "none"
    },
    "nodes": [
      {
        "id": "t1",
        "type": "trigger",
        "event": "appointment.outcome",
        "match": {
          "eq": [
            "{{event._source}}",
            "disposition"
          ]
        }
      },
      {
        "id": "t2",
        "type": "trigger",
        "event": "appointment.status_changed",
        "match": {
          "eq": [
            "{{event.status.to}}",
            "noshow"
          ]
        }
      },
      {
        "id": "b1",
        "type": "branch",
        "title": "Did they show?"
      },
      {
        "id": "g1",
        "type": "slack_post",
        "channel": "{{slack.channel.bookings}}",
        "thread_of": "tag:appointment:{{appointment.id}}",
        "thread_only": true,
        "react": "ghost",
        "as": {
          "name": "No-show",
          "icon": ":ghost:"
        },
        "template": "👻 No-show for the call {{appointment.starts_at | date_company}} with {{appointment.closer.name | default:the closer}}.",
        "title": "React 👻 on the booking post"
      },
      {
        "id": "g2",
        "type": "set_tag",
        "tag": [
          "stat-no-show"
        ]
      },
      {
        "id": "gn1",
        "type": "pipeline_card",
        "pipeline": "{{crm.pipeline_setter}}",
        "stage": "{{crm.stage_setter_cancelled}}",
        "if_missing": "skip",
        "title": "Setter card → No-Show / Cancel / Reschedule, marked lost (the setter pipeline is won on a show, lost on a no-show; the next booking makes a fresh setter card)",
        "status": "lost"
      },
      {
        "id": "gn2",
        "type": "pipeline_card",
        "pipeline": "{{crm.pipeline_closer}}",
        "stage": "{{crm.stage_closer_cancelled}}",
        "if_missing": "skip",
        "title": "Closer card → No Show / Cancelled (move only: they can rebook)"
      },
      {
        "id": "g3",
        "type": "record",
        "event": "intent.unanswered_no_show",
        "only_if": {
          "in": [
            "{{appointment.pending_read.intent}}",
            [
              "cancelled",
              "reschedule_request"
            ]
          ]
        },
        "data": {
          "predicted": "{{appointment.pending_read.intent}}",
          "predicted_confidence": "{{appointment.pending_read.confidence}}",
          "asked_at": "{{appointment.pending_read.at}}",
          "appointment_id": "{{appointment.id}}"
        },
        "title": "Record the no-show after an unanswered cancel or reschedule read"
      },
      {
        "id": "g4",
        "type": "tags",
        "add": [
          "stat-possible-cancel"
        ],
        "only_if": {
          "in": [
            "{{appointment.pending_read.intent}}",
            [
              "cancelled",
              "reschedule_request"
            ]
          ]
        },
        "title": "Tag stat-possible-cancel: we were pretty sure they cancelled and the slot was never opened"
      },
      {
        "id": "s1",
        "type": "slack_post",
        "channel": "{{slack.channel.bookings}}",
        "thread_of": "tag:appointment:{{appointment.id}}",
        "thread_only": true,
        "react": "white_check_mark",
        "as": {
          "name": "Showed",
          "icon": ":white_check_mark:"
        },
        "template": "✅ Showed, per {{appointment.closer.name | default:the closer}}: {{appointment.call_outcome | words | default:no call outcome given}}.",
        "title": "React ✅ on the booking post"
      },
      {
        "id": "s2",
        "type": "set_tag",
        "tag": [
          "stat-showed"
        ]
      },
      {
        "id": "sc1",
        "type": "pipeline_card",
        "pipeline": "{{crm.pipeline_setter}}",
        "stage": "{{crm.stage_setter_showed}}",
        "if_missing": "skip",
        "status": "won",
        "title": "Setter card → Showed, won (as the recording path does; a no-op when it is already there)"
      },
      {
        "id": "b2",
        "type": "branch",
        "title": "How did the call go?"
      },
      {
        "id": "c1",
        "type": "set_tag",
        "tag": [
          "stat-closed-won"
        ]
      },
      {
        "id": "c2",
        "type": "set_tag",
        "tag": [
          "stat-follow-up"
        ]
      },
      {
        "id": "k2",
        "type": "pipeline_card",
        "pipeline": "{{crm.pipeline_closer}}",
        "stage": "{{crm.stage_closer_follow_up}}",
        "if_missing": "skip",
        "title": "Closer card → Follow Up"
      },
      {
        "id": "c3",
        "type": "set_tag",
        "tag": [
          "stat-lost"
        ]
      },
      {
        "id": "k3",
        "type": "pipeline_card",
        "pipeline": "{{crm.pipeline_closer}}",
        "stage": "{{crm.stage_closer_lost}}",
        "if_missing": "skip",
        "status": "lost",
        "title": "Closer card → Lost, marked lost"
      },
      {
        "id": "c4",
        "type": "set_tag",
        "tag": [
          "stat-disqualified"
        ]
      },
      {
        "id": "k4",
        "type": "pipeline_card",
        "pipeline": "{{crm.pipeline_closer}}",
        "stage": "{{crm.stage_closer_disqualified}}",
        "if_missing": "skip",
        "status": "lost",
        "title": "Closer card → Disqualified, marked lost"
      },
      {
        "id": "x0",
        "type": "exit",
        "reason": "nothing_to_mark"
      },
      {
        "id": "x1",
        "type": "exit",
        "reason": "noted"
      },
      {
        "id": "r2",
        "type": "crm_record",
        "object": "custom_objects.sales_call",
        "key": "{{appointment.external_id}}",
        "only_if": {
          "exists": "records.sales_call.key"
        },
        "properties": {
          "external_id": "{{appointment.external_id}}",
          "outcome": "noshow"
        },
        "title": "Sales Call record: no-show"
      },
      {
        "id": "v_disp",
        "type": "set_var",
        "key": "disposition",
        "value": "{{appointment.call_outcome | default:}}",
        "pick": {
          "closed": "closed_won",
          "deposit": "closed_won",
          "follow_up": "follow_up",
          "lost": "lost",
          "unqualified": "dq"
        },
        "else_value": "",
        "title": "The closer's answer as the CRM's disposition"
      },
      {
        "id": "r1",
        "type": "crm_record",
        "object": "custom_objects.sales_call",
        "key": "{{appointment.external_id}}",
        "only_if": {
          "exists": "records.sales_call.key"
        },
        "properties": {
          "external_id": "{{appointment.external_id}}",
          "outcome": "showed",
          "disposition": "{{vars.disposition | oneof:closed_won,follow_up,lost,dq,financing_denied,close_pending | default:}}"
        },
        "title": "Sales Call record: showed, with the disposition"
      }
    ],
    "edges": [
      {
        "from": "t1",
        "to": "b1"
      },
      {
        "from": "t2",
        "to": "g1"
      },
      {
        "from": "b1",
        "to": "g1",
        "when": {
          "eq": [
            "{{event.outcome}}",
            "noshow"
          ]
        },
        "label": "no-show"
      },
      {
        "from": "b1",
        "to": "s1",
        "when": {
          "eq": [
            "{{event.outcome}}",
            "showed"
          ]
        },
        "label": "showed"
      },
      {
        "from": "b1",
        "to": "x0",
        "else": true,
        "label": "rescheduled: the booking post already has the 🔁"
      },
      {
        "from": "g1",
        "to": "g2"
      },
      {
        "from": "s1",
        "to": "s2"
      },
      {
        "from": "b2",
        "to": "c1",
        "when": {
          "in": [
            "{{appointment.call_outcome}}",
            [
              "closed",
              "deposit"
            ]
          ]
        },
        "label": "closed or deposit"
      },
      {
        "from": "b2",
        "to": "c2",
        "when": {
          "eq": [
            "{{appointment.call_outcome}}",
            "follow_up"
          ]
        },
        "label": "follow-up"
      },
      {
        "from": "b2",
        "to": "c3",
        "when": {
          "eq": [
            "{{appointment.call_outcome}}",
            "lost"
          ]
        },
        "label": "lost"
      },
      {
        "from": "b2",
        "to": "c4",
        "when": {
          "eq": [
            "{{appointment.call_outcome}}",
            "unqualified"
          ]
        },
        "label": "disqualified"
      },
      {
        "from": "b2",
        "to": "x1",
        "else": true,
        "label": "no call outcome given"
      },
      {
        "from": "c1",
        "to": "x1"
      },
      {
        "from": "c2",
        "to": "k2"
      },
      {
        "from": "c3",
        "to": "k3"
      },
      {
        "from": "c4",
        "to": "k4"
      },
      {
        "from": "g2",
        "to": "gn1"
      },
      {
        "from": "g3",
        "to": "g4"
      },
      {
        "from": "r2",
        "to": "x1"
      },
      {
        "from": "s2",
        "to": "sc1"
      },
      {
        "from": "v_disp",
        "to": "r1"
      },
      {
        "from": "r1",
        "to": "b2"
      },
      {
        "from": "g4",
        "to": "r2"
      },
      {
        "from": "gn1",
        "to": "gn2"
      },
      {
        "from": "gn2",
        "to": "g3"
      },
      {
        "from": "sc1",
        "to": "v_disp"
      },
      {
        "from": "k2",
        "to": "x1"
      },
      {
        "from": "k3",
        "to": "x1"
      },
      {
        "from": "k4",
        "to": "x1"
      }
    ]
  }
}
