{
 "workflow": "call-booked",
 "note": "PMU: one board, one card fork after the setter / self paths: a new booking puts the card on Booked Call named -- Direct or -- Setter; a reschedule moves it to Rescheduled only off a pre-call stage and keeps its name; the Sales Call says Closing or Demo; no UTM fields; Appointment Start Time in PMU's format (MM-dd-yyyy HH:mm)",
 "definition": {
  "schema": 1,
  "reentry": "always",
  "premise": {
   "check": "appointment_exists"
  },
  "nodes": [
   {
    "id": "t1",
    "type": "trigger",
    "event": "appointment.booked",
    "match": {
     "eq": [
      "{{appointment.term.category}}",
      "closing"
     ]
    }
   },
   {
    "id": "t2",
    "type": "trigger",
    "event": "appointment.rescheduled",
    "match": {
     "eq": [
      "{{appointment.term.category}}",
      "closing"
     ]
    }
   },
   {
    "id": "c_via",
    "type": "set_var",
    "key": "booked_via",
    "value": "{{appointment.source}}",
    "pick": {
     "calendly": "Calendly",
     "ghl": "GHL calendar"
    },
    "else_value": "booking page",
    "title": "Where the booking came from, in words"
   },
   {
    "id": "c0",
    "type": "ensure_contact",
    "title": "Make sure the person is in GHL: found by id, email or phone, else created",
    "source": "{{vars.booked_via}} booking",
    "scope_tag": true
   },
   {
    "id": "c_added",
    "type": "set_var",
    "key": "added_line",
    "value": "{{vars.c0.action}}",
    "pick": {
     "created": "*New to GHL:* added from their {{vars.booked_via}} booking"
    },
    "else_value": "",
    "title": "A line on the card when the booking put them in GHL"
   },
   {
    "id": "c_note",
    "type": "note",
    "only_if": {
     "eq": [
      "{{vars.c0.action}}",
      "created"
     ]
    },
    "template": "Added to GHL by the booking engine from their {{vars.booked_via}} booking ({{appointment.starts_at | date_company}}): they were not in GHL by email or phone.",
    "title": "Say on the contact that the booking added them"
   },
   {
    "id": "n1",
    "type": "update_contact",
    "set": {
     "assign_to": "{{appointment.closer.ghl_user_id | default:}}"
    },
    "fields": [
     {
      "id": "{{crm.field_contact_appointment_date}}",
      "value": "{{appointment.starts_at | date_company:MM-dd-yyyy HH:mm}}"
     }
    ]
   },
   {
    "id": "n2",
    "type": "branch"
   },
   {
    "id": "s1",
    "type": "set_var",
    "key": "setter_line",
    "value": ""
   },
   {
    "id": "s2",
    "type": "set_var",
    "key": "booking_kind",
    "value": "self-booked"
   },
   {
    "id": "s2b",
    "type": "set_var",
    "key": "booking_source",
    "value": "{{picklist.sales_call_booking_source.self}}"
   },
   {
    "id": "s_suffix",
    "type": "set_var",
    "key": "card_suffix",
    "value": "Direct"
   },
   {
    "id": "s5",
    "type": "tags",
    "add": [
     "stat-call-booked",
     "stat-self-booked",
     "meta booked call"
    ],
    "remove": [
     "seq-no-show",
     "seq-nurture",
     "seq-winback",
     "opt-in lead",
     "stat-no-show",
     "stat-cancelled",
     "stat-possible-cancel",
     "stat-needs-attention",
     "stat-call-not-booked"
    ]
   },
   {
    "id": "b1",
    "type": "set_var",
    "key": "setter_line",
    "value": "*Setter:* {{appointment.set_by | default:unknown}}"
   },
   {
    "id": "b2",
    "type": "set_var",
    "key": "booking_kind",
    "value": "setter booked"
   },
   {
    "id": "b2b",
    "type": "set_var",
    "key": "booking_source",
    "value": "{{picklist.sales_call_booking_source.setter}}"
   },
   {
    "id": "b3",
    "type": "update_contact",
    "fields": [
     {
      "id": "{{crm.field_contact_setter}}",
      "value": "{{appointment.set_by | default:}}"
     }
    ],
    "followers": [
     "{{appointment.setter.ghl_user_id | default:}}"
    ],
    "title": "The setter goes on the contact"
   },
   {
    "id": "b_suffix",
    "type": "set_var",
    "key": "card_suffix",
    "value": "Setter"
   },
   {
    "id": "b6",
    "type": "tags",
    "add": [
     "stat-call-booked",
     "stat-set",
     "meta booked call"
    ],
    "remove": [
     "seq-no-show",
     "seq-nurture",
     "seq-winback",
     "opt-in lead",
     "stat-no-show",
     "stat-cancelled",
     "stat-possible-cancel",
     "stat-needs-attention",
     "stat-call-not-booked"
    ]
   },
   {
    "id": "f_card",
    "type": "branch",
    "title": "A new booking or a reschedule?"
   },
   {
    "type": "pipeline_card",
    "pipeline": "{{crm.pipeline_closer}}",
    "stage": "{{crm.stage_closer_scheduled}}",
    "name": "{{contact.name}} -- {{vars.card_suffix}}",
    "assign_to": "{{appointment.closer.ghl_user_id | default:}}",
    "fields": [
     {
      "id": "{{crm.field_opportunity_setter_owner | default:}}",
      "value": "{{appointment.set_by | default:}}"
     }
    ],
    "id": "c_new",
    "title": "Card → Booked Call, named -- Setter / -- Direct",
    "followers": [
     "{{appointment.setter.ghl_user_id | default:}}"
    ]
   },
   {
    "type": "pipeline_card",
    "pipeline": "{{crm.pipeline_closer}}",
    "stage": "{{crm.stage_closer_rescheduled}}",
    "name": "{{contact.name}} -- {{vars.card_suffix}}",
    "assign_to": "{{appointment.closer.ghl_user_id | default:}}",
    "fields": [
     {
      "id": "{{crm.field_opportunity_setter_owner | default:}}",
      "value": "{{appointment.set_by | default:}}"
     }
    ],
    "id": "c_rs",
    "title": "Card → Rescheduled, if it is before the call (its name stays)",
    "keep_name": true,
    "from_stages": [
     "{{crm.stage_closer_new_lead}}",
     "{{crm.stage_closer_scheduled}}",
     "{{crm.stage_closer_unresponsive}}",
     "{{crm.stage_closer_confirmed}}",
     "{{crm.stage_closer_no_show}}",
     "{{crm.stage_closer_cancelled}}",
     "{{crm.stage_closer_rescheduled}}"
    ],
    "followers": [
     "{{appointment.setter.ghl_user_id | default:}}"
    ]
   },
   {
    "id": "k3",
    "type": "create_task",
    "title": "Send {{contact.first_name}} a personalized video",
    "body": "Booked for {{appointment.starts_at | date_company}}. A quick personal video before the call.",
    "due": "+1d",
    "assign_to": "{{appointment.closer.ghl_user_id | default:}}"
   },
   {
    "id": "k5",
    "type": "crm_record",
    "object": "{{crm.object_sales_call | default:custom_objects.sales_call}}",
    "key": "{{event.slot.from | default:}}",
    "if_missing": "skip",
    "properties": {
     "outcome": "{{picklist.sales_call_outcome.rescheduled}}"
    },
    "title": "The Sales Call for the old time: logged as rescheduled"
   },
   {
    "id": "v_type",
    "type": "set_var",
    "title": "Closing or Demo: the call type the calendar books",
    "key": "call_type",
    "value": "{{appointment.term.name}}",
    "pick": {
     "Demo call": "demo"
    },
    "else_value": "closing"
   },
   {
    "id": "k4",
    "type": "crm_record",
    "object": "{{crm.object_sales_call | default:custom_objects.sales_call}}",
    "key": "{{appointment.slot_key}}",
    "properties": {
     "display_label": "{{contact.name | default:Unknown}} — {{appointment.starts_at | date_company:yyyy-MM-dd}}",
     "external_id": "{{appointment.slot_key}}",
     "contact_id": "{{contact.ghl_contact_id | default:}}",
     "opportunity_id": "{{cards.closer.id | default:}}",
     "scheduled_at": "{{appointment.starts_at}}",
     "call_date": "{{appointment.starts_at | date_company:yyyy-MM-dd}}",
     "closer": "{{appointment.closer.first_name | default: | lower}}",
     "setter": "{{appointment.set_by | default:}}",
     "outcome": "{{picklist.sales_call_outcome.scheduled}}",
     "booking_source": "{{vars.booking_source | default:}}",
     "call_type": "{{vars.call_type}}"
    },
    "relate": [
     {
      "association": "{{crm.assoc_sales_call_contact}}",
      "first": "{{contact.ghl_contact_id | default:}}",
      "second": "{{record.id}}"
     },
     {
      "association": "{{crm.assoc_sales_call_opportunity}}",
      "first": "{{record.id}}",
      "second": "{{cards.closer.id | default:}}"
     }
    ]
   },
   {
    "id": "v4",
    "type": "set_var",
    "key": "card",
    "when": {
     "eq": [
      "{{event._type}}",
      "appointment.rescheduled"
     ]
    },
    "value": {
     "name": "Call rescheduled",
     "icons": [
      ":repeat:"
     ],
     "reschedule_mark": "repeat"
    },
    "else_value": {
     "name": "New call booked",
     "icons": [
      ":telephone_receiver:",
      ":calendar:",
      ":date:",
      ":spiral_calendar_pad:"
     ],
     "reschedule_mark": ""
    }
   },
   {
    "id": "n4",
    "type": "slack_post",
    "channel": "{{slack.channel.bookings}}",
    "template": "*Name:* <https://app.gohighlevel.com/v2/location/{{crm.location_id}}/contacts/detail/{{contact.ghl_contact_id | default:}}|{{contact.name | default:Unknown}}>\n*Booked with:* {{appointment.closer.name | default:unassigned}}\n{{vars.setter_line}}\n*Appointment time:* {{appointment.starts_at | date_company}}\n*Phone:* {{contact.phone | default:—}}{{contact.intake_lines | line}}\n*Reschedule link:* {{appointment.reschedule_url | default:—}}\n*Source:* {{contact.source | default:—}} · {{vars.booking_kind}}{{vars.added_line | line}}",
    "as": {
     "name": "{{vars.card.name}}",
     "icon": "{{vars.card.icons}}"
    },
    "title": "Post the booking card in Slack (a reschedule: 🔁 face, 🔁 on the old card)",
    "tag": "appointment:{{appointment.id}}",
    "react_on": {
     "of": "tag:appointment:{{appointment.id}}",
     "emojis": [
      "{{vars.card.reschedule_mark}}"
     ]
    }
   },
   {
    "id": "v_textoff",
    "type": "set_var",
    "key": "no_text_reason",
    "value": "{{contact.sms_dnd}}",
    "pick": {
     "true": "has texts turned off (Do Not Disturb)"
    },
    "else_value": "",
    "title": "Why no text can reach them: Do Not Disturb, or no phone"
   },
   {
    "id": "v_nophone",
    "type": "set_var",
    "key": "no_text_reason",
    "when": {
     "and": [
      {
       "eq": [
        "{{vars.no_text_reason}}",
        ""
       ]
      },
      {
       "not": {
        "exists": "contact.phone"
       }
      }
     ]
    },
    "value": "has no phone number on file",
    "else_value": "{{vars.no_text_reason}}",
    "title": "…or no phone number on file"
   },
   {
    "id": "n_dnd",
    "type": "slack_post",
    "channel": "{{slack.channel.bookings}}",
    "thread_of": "tag:appointment:{{appointment.id}}",
    "thread_only": true,
    "react": "warning",
    "only_if": {
     "and": [
      {
       "neq": [
        "{{vars.no_text_reason}}",
        ""
       ]
      },
      {
       "neq": [
        "{{event._type}}",
        "appointment.rescheduled"
       ]
      }
     ]
    },
    "as": {
     "name": "Texts off",
     "icon": ":warning:"
    },
    "template": "⚠️ {{contact.first_name | default:They}} {{vars.no_text_reason}}, so no texts will reach them. Call or email instead.",
    "title": "Texts can't reach them (Do Not Disturb or no phone): ⚠️ on the card and a note under it, once per booking"
   },
   {
    "id": "n_nolink_note",
    "type": "slack_post",
    "channel": "{{slack.channel.bookings}}",
    "thread_of": "tag:appointment:{{appointment.id}}",
    "thread_only": true,
    "only_if": {
     "not": {
      "exists": "appointment.meeting_url"
     }
    },
    "react": "link",
    "as": {
     "name": "No meeting link",
     "icon": ":link:"
    },
    "template": "🔗 No meeting link on this call. {{appointment.closer.mention | default:Closer}}, please send them the link.",
    "title": "No meeting link: a note under the booking card, 🔗 on it"
   },
   {
    "id": "n_nolink_alert",
    "type": "slack_post",
    "channel": "{{slack.channel.no_link_alerts}}",
    "fallback_channel": "{{slack.channel.alerts}}",
    "only_if": {
     "not": {
      "exists": "appointment.meeting_url"
     }
    },
    "as": {
     "name": "No meeting link",
     "icon": ":link:"
    },
    "template": "{{appointment.closer.mention | default:Heads up}}: {{contact.name | default:A contact}}'s call {{appointment.starts_at | date_company}} has no meeting link. Please send them the link.",
    "title": "No meeting link: an issue in the no-link channel (else the alerts channel)"
   },
   {
    "id": "x1",
    "type": "exit",
    "reason": "booked"
   },
   {
    "id": "fu1",
    "type": "set_var",
    "key": "setter_line",
    "value": "*Follow-up* on an earlier call{{contact.setter.name | default: | then:\" · setter \"}}{{contact.setter.name | default:}}",
    "title": "A follow-up: the post says so, and who set them first"
   },
   {
    "id": "fu2",
    "type": "set_var",
    "key": "booking_kind",
    "value": "follow-up"
   },
   {
    "id": "fu3",
    "type": "set_var",
    "key": "booking_source",
    "when": {
     "exists": "contact.setter.name"
    },
    "value": "{{picklist.sales_call_booking_source.setter}}",
    "else_value": "{{picklist.sales_call_booking_source.self}}"
   },
   {
    "id": "fu4",
    "type": "tags",
    "add": [
     "stat-follow-up-booked",
     "meta booked call"
    ],
    "remove": [
     "seq-no-show",
     "seq-nurture",
     "seq-winback",
     "opt-in lead",
     "stat-no-show",
     "stat-cancelled",
     "stat-possible-cancel",
     "stat-needs-attention",
     "stat-call-not-booked"
    ],
    "title": "Tags: a follow-up booked (not a new set)"
   },
   {
    "type": "pipeline_card",
    "pipeline": "{{crm.pipeline_closer}}",
    "stage": "{{crm.stage_closer_scheduled}}",
    "name": "{{contact.name}} -- Follow Up",
    "assign_to": "{{appointment.closer.ghl_user_id | default:}}",
    "id": "fu_card",
    "title": "Closer card → Scheduled, its name kept (a follow-up)",
    "keep_name": true
   },
   {
    "id": "fu_rs",
    "type": "crm_record",
    "object": "{{crm.object_sales_call | default:custom_objects.sales_call}}",
    "key": "{{event.slot.from | default:}}",
    "if_missing": "skip",
    "properties": {
     "outcome": "{{picklist.sales_call_outcome.rescheduled}}"
    },
    "title": "The Sales Call for the old time: logged as rescheduled",
    "only_if": {
     "eq": [
      "{{event._type}}",
      "appointment.rescheduled"
     ]
    }
   },
   {
    "id": "fu_sc",
    "type": "crm_record",
    "object": "{{crm.object_sales_call | default:custom_objects.sales_call}}",
    "key": "{{appointment.slot_key}}",
    "properties": {
     "display_label": "{{contact.name | default:Unknown}} — {{appointment.starts_at | date_company:yyyy-MM-dd}}",
     "external_id": "{{appointment.slot_key}}",
     "contact_id": "{{contact.ghl_contact_id | default:}}",
     "opportunity_id": "{{cards.closer.id | default:}}",
     "scheduled_at": "{{appointment.starts_at}}",
     "call_date": "{{appointment.starts_at | date_company:yyyy-MM-dd}}",
     "closer": "{{appointment.closer.name | default: | option:sales_call_closer}}",
     "setter": "{{contact.setter.name | default:}}",
     "outcome": "{{picklist.sales_call_outcome.scheduled}}",
     "booking_source": "{{vars.booking_source | default:}}",
     "call_type": "follow_up"
    },
    "relate": [
     {
      "association": "{{crm.assoc_sales_call_contact}}",
      "first": "{{contact.ghl_contact_id | default:}}",
      "second": "{{record.id}}"
     },
     {
      "association": "{{crm.assoc_sales_call_opportunity}}",
      "first": "{{record.id}}",
      "second": "{{cards.closer.id | default:}}"
     }
    ],
    "title": "The follow-up's own Sales Call (call type follow_up, the original setter)"
   },
   {
    "id": "fu_v",
    "type": "set_var",
    "key": "card",
    "when": {
     "eq": [
      "{{event._type}}",
      "appointment.rescheduled"
     ]
    },
    "value": {
     "name": "Follow-up rescheduled",
     "icons": [
      ":repeat:"
     ],
     "reschedule_mark": "repeat"
    },
    "else_value": {
     "name": "Follow-up booked",
     "icons": [
      ":repeat_one:"
     ],
     "reschedule_mark": ""
    }
   },
   {
    "id": "fu0",
    "type": "branch",
    "title": "A follow-up? (an earlier closing call of theirs was held)"
   }
  ],
  "edges": [
   {
    "from": "t1",
    "to": "c_via"
   },
   {
    "from": "t2",
    "to": "c_via"
   },
   {
    "from": "c_note",
    "to": "n1"
   },
   {
    "from": "n1",
    "to": "fu0"
   },
   {
    "from": "n2",
    "to": "b1",
    "when": {
     "eq": [
      "{{appointment.self_booked}}",
      false
     ]
    },
    "label": "setter booked"
   },
   {
    "from": "n2",
    "to": "s1",
    "else": true,
    "label": "self-booked"
   },
   {
    "from": "s1",
    "to": "s2"
   },
   {
    "from": "s2",
    "to": "s2b"
   },
   {
    "from": "b1",
    "to": "b2"
   },
   {
    "from": "b2",
    "to": "b2b"
   },
   {
    "from": "b3",
    "to": "b_suffix"
   },
   {
    "from": "k4",
    "to": "v4"
   },
   {
    "from": "v4",
    "to": "n4"
   },
   {
    "from": "n4",
    "to": "v_textoff"
   },
   {
    "from": "s2b",
    "to": "s_suffix"
   },
   {
    "from": "b2b",
    "to": "b3"
   },
   {
    "from": "c_via",
    "to": "c0"
   },
   {
    "from": "c0",
    "to": "c_added"
   },
   {
    "from": "c_added",
    "to": "c_note"
   },
   {
    "from": "n_dnd",
    "to": "n_nolink_note"
   },
   {
    "from": "v_textoff",
    "to": "v_nophone"
   },
   {
    "from": "v_nophone",
    "to": "n_dnd"
   },
   {
    "from": "s_suffix",
    "to": "s5"
   },
   {
    "from": "s5",
    "to": "f_card"
   },
   {
    "from": "b6",
    "to": "f_card"
   },
   {
    "from": "f_card",
    "to": "c_rs",
    "label": "a reschedule",
    "when": {
     "eq": [
      "{{event._type}}",
      "appointment.rescheduled"
     ]
    }
   },
   {
    "from": "f_card",
    "to": "c_new",
    "label": "a new booking",
    "else": true
   },
   {
    "from": "c_new",
    "to": "k3"
   },
   {
    "from": "k3",
    "to": "v_type"
   },
   {
    "from": "c_rs",
    "to": "k5"
   },
   {
    "from": "k5",
    "to": "v_type"
   },
   {
    "from": "n_nolink_note",
    "to": "n_nolink_alert"
   },
   {
    "from": "n_nolink_alert",
    "to": "x1"
   },
   {
    "from": "fu0",
    "to": "fu1",
    "when": {
     "eq": [
      "{{appointment.follow_up}}",
      true
     ]
    },
    "label": "a follow-up"
   },
   {
    "from": "fu0",
    "to": "n2",
    "else": true,
    "label": "a new set"
   },
   {
    "from": "fu1",
    "to": "fu2"
   },
   {
    "from": "fu2",
    "to": "fu3"
   },
   {
    "from": "fu3",
    "to": "fu4"
   },
   {
    "from": "fu4",
    "to": "fu_card"
   },
   {
    "from": "fu_card",
    "to": "fu_rs"
   },
   {
    "from": "fu_rs",
    "to": "fu_sc"
   },
   {
    "from": "fu_sc",
    "to": "fu_v"
   },
   {
    "from": "fu_v",
    "to": "n4"
   },
   {
    "from": "b_suffix",
    "to": "b6"
   },
   {
    "from": "v_type",
    "to": "k4"
   }
  ]
