{
 "workflow": "eod-call-filed",
 "note": "PMU: the closer's answer goes on the Sales Call in PMU's disposition keys; a deposit is its own (Deposit)",
 "definition": {
  "schema": 1,
  "reentry": "always",
  "premise": {
   "check": "none"
  },
  "nodes": [
   {
    "id": "t1",
    "type": "trigger",
    "event": "eod.call_filed"
   },
   {
    "id": "v_outcome",
    "type": "set_var",
    "key": "outcome",
    "value": "{{event.attendance}}",
    "pick": {
     "showed": "{{picklist.sales_call_outcome.showed}}",
     "noshow": "{{picklist.sales_call_outcome.noshow}}",
     "rescheduled": "{{picklist.sales_call_outcome.on_call}}"
    },
    "else_value": "",
    "title": "The attendance in the company's own option keys"
   },
   {
    "id": "v_disp",
    "type": "set_var",
    "key": "disposition",
    "value": "{{event.meaning | default:}}",
    "pick": {
     "closed": "closed_won",
     "deposit": "deposit",
     "follow_up": "follow_up",
     "lost": "lost",
     "unqualified": "dq"
    },
    "else_value": "",
    "title": "The answer as the CRM's disposition"
   },
   {
    "id": "b1",
    "type": "branch",
    "title": "Did the call happen with an outcome?"
   },
   {
    "id": "r_held",
    "type": "crm_record",
    "object": "{{crm.object_sales_call}}",
    "record_id": "{{event.record_id}}",
    "properties": {
     "outcome": "{{vars.outcome}}",
     "disposition": "{{vars.disposition}}"
    },
    "title": "Sales Call record: the attendance and the disposition"
   },
   {
    "id": "r_empty",
    "type": "crm_record",
    "object": "{{crm.object_sales_call}}",
    "record_id": "{{event.record_id}}",
    "properties": {
     "outcome": "{{vars.outcome}}"
    },
    "clear": [
     "disposition",
     "cash_collected",
     "objection_primary",
     "next_step",
     "next_step_date",
     "payment_terms"
    ],
    "title": "Sales Call record: the attendance; what a held call carries is emptied"
   },
   {
    "id": "x1",
    "type": "exit",
    "reason": "filed"
   }
  ],
  "edges": [
   {
    "from": "t1",
    "to": "v_outcome"
   },
   {
    "from": "v_outcome",
    "to": "v_disp"
   },
   {
    "from": "v_disp",
    "to": "b1"
   },
   {
    "from": "b1",
    "to": "r_held",
    "when": {
     "neq": [
      "{{vars.disposition}}",
      ""
     ]
    },
    "label": "a call outcome"
   },
   {
    "from": "b1",
    "to": "r_empty",
    "else": true,
    "label": "no-show, rescheduled, or no call outcome"
   },
   {
    "from": "r_held",
    "to": "x1"
   },
   {
    "from": "r_empty",
    "to": "x1"
   }
  ]
 }
}
