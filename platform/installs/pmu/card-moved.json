{
 "workflow": "card-moved",
 "note": "PMU: a card moved by hand into No Show after the call started files a no-show",
 "definition": {
  "schema": 1,
  "reentry": "always",
  "premise": {
   "check": "none"
  },
  "nodes": [
   {
    "id": "t1",
    "type": "trigger",
    "event": "card.moved"
   },
   {
    "id": "v_status",
    "type": "set_var",
    "key": "status_part",
    "when": {
     "neq": [
      "{{event.from_status}}",
      "{{event.to_status}}"
     ]
    },
    "value": " and marked it {{event.to_status}}",
    "else_value": "",
    "title": "Whether the status changed too"
   },
   {
    "id": "v_line",
    "type": "set_var",
    "key": "line",
    "when": {
     "neq": [
      "{{event.from_stage}}",
      "{{event.to_stage}}"
     ]
    },
    "value": "\ud83d\uddc2\ufe0f {{event.mover | default:someone}} moved the {{event.pipeline}} card to {{event.to_name}}{{vars.status_part}}",
    "else_value": "\ud83d\uddc2\ufe0f {{event.mover | default:someone}} marked the {{event.pipeline}} card {{event.to_status}}",
    "title": "The thread line"
   },
   {
    "id": "n_line",
    "type": "slack_post",
    "channel": "{{slack.channel.bookings}}",
    "thread_of": "tag:appointment:{{appointment.id}}",
    "thread_only": true,
    "as": {
     "name": "Card moved",
     "icon": ":card_index_dividers:"
    },
    "template": "{{vars.line}}",
    "title": "Say who moved the card, in the booking post's thread"
   },
   {
    "id": "b1",
    "type": "branch",
    "title": "Does the stage name an outcome for a call that has started?"
   },
   {
    "id": "o_noshow",
    "type": "record_outcome",
    "outcome": "noshow",
    "source": "disposition",
    "user": "{{event.mover_id | default:}}",
    "via": "card_moved",
    "notes": "Card moved to {{event.to_name}} in the CRM by {{event.mover | default:someone}}",
    "title": "File a no-show, as the form would"
   },
   {
    "id": "o_lost",
    "type": "record_outcome",
    "outcome": "showed",
    "call_outcome": "lost",
    "source": "disposition",
    "user": "{{event.mover_id | default:}}",
    "via": "card_moved",
    "notes": "Card moved to {{event.to_name}} in the CRM by {{event.mover | default:someone}}",
    "title": "File a show that was lost, as the form would"
   },
   {
    "id": "o_dq",
    "type": "record_outcome",
    "outcome": "showed",
    "call_outcome": "unqualified",
    "source": "disposition",
    "user": "{{event.mover_id | default:}}",
    "via": "card_moved",
    "notes": "Card moved to {{event.to_name}} in the CRM by {{event.mover | default:someone}}",
    "title": "File a show that was disqualified, as the form would"
   },
   {
    "id": "x_filed",
    "type": "exit",
    "reason": "filed"
   },
   {
    "id": "x_noted",
    "type": "exit",
    "reason": "noted"
   }
  ],
  "edges": [
   {
    "from": "t1",
    "to": "v_status"
   },
   {
    "from": "v_status",
    "to": "v_line"
   },
   {
    "from": "v_line",
    "to": "n_line"
   },
   {
    "from": "n_line",
    "to": "b1"
   },
   {
    "from": "b1",
    "to": "o_noshow",
    "label": "into a no-show stage",
    "when": {
     "and": [
      {
       "eq": [
        "{{appointment.started}}",
        true
       ]
      },
      {
       "neq": [
        "{{event.from_stage}}",
        "{{event.to_stage}}"
       ]
      },
      {
       "neq": [
        "{{appointment.outcome | default:}}",
        "noshow"
       ]
      },
      {
       "and": [
        {
         "eq": [
          "{{event.pipeline}}",
          "closer"
         ]
        },
        {
         "eq": [
          "{{event.to_stage}}",
          "{{crm.stage_closer_no_show | default:}}"
         ]
        }
       ]
      }
     ]
    }
   },
   {
    "from": "b1",
    "to": "o_lost",
    "label": "into Lost",
    "when": {
     "and": [
      {
       "eq": [
        "{{appointment.started}}",
        true
       ]
      },
      {
       "neq": [
        "{{event.from_stage}}",
        "{{event.to_stage}}"
       ]
      },
      {
       "neq": [
        "{{appointment.call_outcome | default:}}",
        "lost"
       ]
      },
      {
       "eq": [
        "{{event.pipeline}}",
        "closer"
       ]
      },
      {
       "eq": [
        "{{event.to_stage}}",
        "{{crm.stage_closer_lost | default:}}"
       ]
      }
     ]
    }
   },
   {
    "from": "b1",
    "to": "o_dq",
    "label": "into Disqualified",
    "when": {
     "and": [
      {
       "eq": [
        "{{appointment.started}}",
        true
       ]
      },
      {
       "neq": [
        "{{event.from_stage}}",
        "{{event.to_stage}}"
       ]
      },
      {
       "neq": [
        "{{appointment.call_outcome | default:}}",
        "unqualified"
       ]
      },
      {
       "eq": [
        "{{event.pipeline}}",
        "closer"
       ]
      },
      {
       "eq": [
        "{{event.to_stage}}",
        "{{crm.stage_closer_disqualified | default:}}"
       ]
      }
     ]
    }
   },
   {
    "from": "b1",
    "to": "x_noted",
    "else": true,
    "label": "any other stage, or nothing new to file: noted"
   },
   {
    "from": "o_noshow",
    "to": "x_filed"
   },
   {
    "from": "o_lost",
    "to": "x_filed"
   },
   {
    "from": "o_dq",
    "to": "x_filed"
   }
  ]
 }
}
