{
 "workflow": "call-recorded",
 "note": "PMU: one board. No setter card to mark showed; the closer and objection in PMU's own dropdown keys (the disposition is the end of day's, D271); the GHL note is Tyler's five sections (current situation, pains, goals, objections, next steps) and the Fathom link, the Slack post says the same with his emoji, the scorecard only in the thread",
 "definition": {
  "schema": 1,
  "reentry": "always",
  "premise": {
   "check": "contact_exists"
  },
  "nodes": [
   {
    "id": "t1",
    "type": "trigger",
    "event": "recording.received",
    "title": "A meeting recording came in (Fathom)"
   },
   {
    "id": "t2",
    "type": "trigger",
    "event": "call.closing",
    "title": "A dialer call Jev read as a closing call (Setter call logged hands it over)"
   },
   {
    "id": "l_conv",
    "type": "lookup",
    "query": "call_conversation",
    "params": {
     "recording_id": "{{recording.id}}",
     "gap_min": "{{setting.calls.conversation_gap_min}}"
    },
    "into": "convo",
    "title": "The whole call: a dialer call in parts (a dropped line) is read as one; a meeting recording is its own whole"
   },
   {
    "id": "a1",
    "type": "classify",
    "input": "{{vars.convo.transcript_text}}",
    "domain": "recording_kind",
    "question": "What kind of recording is this?",
    "criteria": {
     "sales_call": "A conversation between someone on the team and a prospect or customer about buying, starting, continuing or paying for the program.",
     "internal": "Team members talking to each other: a standup, training, role-play, a vendor call.",
     "other": "Anything else: a voicemail, a wrong number, a personal call, an unrelated meeting."
    },
    "threshold": 0.8,
    "ambiguity_max": 0.8,
    "into": "vars.classify.kind",
    "title": "Jev: is it a sales call? (a dialer call Jev already read as closing skips this)",
    "only_if": {
     "eq": [
      "{{event._type}}",
      "recording.received"
     ]
    }
   },
   {
    "id": "c1",
    "type": "check",
    "when": {
     "or": [
      {
       "eq": [
        "{{vars.classify.kind}}",
        "sales_call"
       ]
      },
      {
       "eq": [
        "{{event._type}}",
        "call.closing"
       ]
      }
     ]
    },
    "else_exit": "not_a_sales_call"
   },
   {
    "id": "a3",
    "type": "classify",
    "input": "{{vars.convo.transcript_text}}",
    "domain": "sales_call_disposition",
    "question": "How did this sales call end?",
    "criteria": {
     "closed_won": "They agreed to buy and payment was arranged or taken on the call.",
     "close_pending": "They agreed in principle; payment or paperwork is still to come.",
     "follow_up": "No decision yet; a next conversation or a think-it-over was agreed.",
     "lost": "They said no.",
     "dq": "Not a fit: the team disqualified them.",
     "financing_denied": "They wanted to buy but could not pay or finance.",
     "unclear": "The transcript does not show how it ended."
    },
    "threshold": 0.7,
    "ambiguity_max": 0.85,
    "into": "vars.outcome.disposition",
    "title": "Jev: how did the call end?"
   },
   {
    "id": "a2",
    "type": "analyze",
    "prompt": "{{prompt.call_review}}",
    "into": [
     "notes",
     "rubric"
    ],
    "title": "AI: call notes and scorecard",
    "input": "{{vars.convo.transcript_text}}",
    "model": "claude-sonnet-5-5",
    "max_tokens": 16000
   },
   {
    "id": "v_parts",
    "type": "set_var",
    "key": "parts_line",
    "value": " ({{vars.convo.count}} parts)",
    "when": {
     "gt": [
      "{{vars.convo.count}}",
      1
     ]
    },
    "else_value": "",
    "title": "A call in parts says so"
   },
   {
    "id": "v_rec",
    "type": "set_var",
    "key": "recording_line",
    "value": "{{recording.provider}}",
    "pick": {
     "ghl": "\n*Recording:* <{{recording.share_url | default:}}|Open the call in GHL>"
    },
    "else_value": "{{recording.share_url | link:Fathom | line:*Recording:*}}"
   },
   {
    "id": "b1",
    "type": "branch"
   },
   {
    "id": "o1",
    "type": "record_outcome",
    "outcome": "showed"
   },
   {
    "id": "o2",
    "type": "set_tag",
    "tag": [
     "stat-showed"
    ]
   },
   {
    "id": "o4",
    "type": "slack_post",
    "channel": "{{slack.channel.bookings}}",
    "thread_of": "tag:appointment:{{appointment.id}}",
    "thread_only": true,
    "react": "white_check_mark",
    "as": {
     "name": "Showed",
     "icon": ":white_check_mark:"
    },
    "template": "✅ Showed · {{vars.convo.total_min | default:?}} min{{vars.parts_line}} with {{recording.credited.name | default:the closer}}. The review is in the calls channel.",
    "title": "React ✅ on the booking post",
    "tag": "showed:{{appointment.id}}",
    "edit": true
   },
   {
    "id": "k1",
    "type": "set_var",
    "key": "call_key",
    "value": "{{appointment.slot_key}}"
   },
   {
    "id": "k3",
    "type": "set_var",
    "key": "appt_line",
    "value": "*Appointment:* {{appointment.starts_at | date_company}} · marked showed"
   },
   {
    "id": "k2",
    "type": "set_var",
    "key": "call_key",
    "value": "{{recording.provider}}-{{vars.convo.key}}"
   },
   {
    "id": "k4",
    "type": "set_var",
    "key": "appt_line",
    "value": "⚠️ No appointment matched this recording — nothing marked showed. Check the contact's bookings."
   },
   {
    "id": "k5",
    "type": "set_var",
    "key": "appt_line",
    "value": "⚠️ A call that lines up with none of their bookings — nothing marked showed. The team is asked which booking it was."
   },
   {
    "id": "r1",
    "type": "crm_record",
    "object": "{{crm.object_sales_call | default:custom_objects.sales_call}}",
    "key": "{{vars.call_key}}",
    "properties": {
     "display_label": "{{contact.name | default:Unknown}} — {{recording.started_at | date_company:yyyy-MM-dd}}",
     "external_id": "{{vars.call_key}}",
     "contact_id": "{{contact.ghl_contact_id | default:}}",
     "opportunity_id": "{{cards.closer.id | default:}}",
     "scheduled_at": "{{appointment.starts_at | default:}}",
     "call_date": "{{recording.started_at | date_company:yyyy-MM-dd}}",
     "recording_url": "{{recording.share_url | default:}}",
     "transcript_ref": "{{recording.url | default:}}",
     "closer": "{{recording.credited.first_name | default: | lower}}",
     "duration_min": "{{vars.convo.total_min | default:}}",
     "objection_primary": "{{vars.notes.primary_objection | oneof:price,think_about_it,spouse_partner,timing,finances,already_working_with_someone,tried_similar_before,no_time_to_implement,skeptical_it_works,needs_more_info,shopping_around,financing_declined,too_early_in_business,went_dark,not_qualified,none | default:}}",
     "next_step": "{{vars.notes.next_step | default:}}",
     "next_step_date": "{{vars.notes.next_step_date | default:}}",
     "payment_terms": "{{vars.notes.payment_terms | default:}}",
     "setter": "{{contact.fields.setter | default:}}"
    },
    "relate": [
     {
      "association": "{{crm.assoc_sales_call_contact}}",
      "first": "{{contact.ghl_contact_id | default:}}",
      "second": "{{record.id}}"
     },
     {
      "association": "{{crm.assoc_sales_call_opportunity}}",
      "first": "{{record.id}}",
      "second": "{{cards.closer.id | default:}}"
     }
    ],
    "template": "CALL SUMMARY — {{recording.started_at | date_company:yyyy-MM-dd}} · {{recording.closer.name | default:closer unknown}}\n\n{{vars.notes | lines}}\n\nCall review: {{vars.rubric.overall_score | default:?}}/10\n{{vars.rubric | lines}}\n\nRecording: {{recording.share_url | default:—}}",
    "only_if": {
     "exists": "vars.call_key"
    }
   },
   {
    "id": "n1",
    "type": "note",
    "template": "CURRENT SITUATION: {{vars.notes.prospect_situation | default:—}}\n\nPAINS: {{vars.notes.pain | join:\" \" | default:—}}\n\nGOALS: {{vars.notes.desire | join:\" \" | default:—}}\n\nOBJECTIONS: {{vars.notes.objections | each:\"{{item.objection}}\" | join:\", \" | default:None}}\n\nNEXT STEPS: {{vars.notes.next_step | default:—}} {{vars.notes.next_step_date | date_company:ccc LLL d | prefix:by}}\n\nFathom recording: {{recording.share_url | default:—}}",
    "key": "review:{{vars.convo.key}}"
   },
   {
    "id": "s1",
    "type": "slack_post",
    "channel": "{{slack.channel.calls}}",
    "template": "*Name:* <https://app.gohighlevel.com/v2/location/{{crm.location_id}}/contacts/detail/{{contact.ghl_contact_id | default:}}|{{contact.name | default:Unknown}}>{{vars.recording_line}}\n{{vars.appt_line}}\n*Closer:* {{recording.credited.name | default:unknown}} · {{vars.convo.total_min | default:?}} min{{vars.parts_line}}\n*Outcome:* {{vars.outcome.disposition | words | default:unclear}}\n\n*Current situation:* {{vars.notes.prospect_situation | default:—}}\n*Pains:* {{vars.notes.pain | join:\" \" | default:—}}\n*Goals:* {{vars.notes.desire | join:\" \" | default:—}}\n*Objections:* {{vars.notes.objections | each:\"{{item.objection}}\" | join:\", \" | default:None}}\n*Next step:* {{vars.notes.next_step | default:—}} {{vars.notes.next_step_date | date_company:ccc LLL d | prefix:by}}",
    "as": {
     "name": "Sales call recorded",
     "icon": [
      ":bomb:",
      ":clapper:",
      ":fire:",
      ":snowman:",
      ":airplane:",
      ":fire_engine:",
      ":tent:",
      ":volcano:",
      ":beach_with_umbrella:",
      ":dragon_face:",
      ":eagle:",
      ":panda_face:",
      ":wolf:",
      ":lion_face:",
      ":brain:",
      ":dizzy:",
      ":boom:",
      ":mirror_ball:",
      ":ninja:",
      ":gorilla:"
     ]
    },
    "title": "Post the call review in Slack (the same call again edits it)",
    "tag": "recording:{{vars.convo.first.id}}",
    "edit": true
   },
   {
    "id": "s2",
    "type": "slack_post",
    "channel": "{{slack.channel.calls}}",
    "thread_of": "s1",
    "as": {
     "name": "Call review",
     "icon": [
      ":clipboard:",
      ":bar_chart:",
      ":mag:"
     ]
    },
    "template": "*Scorecard:* {{vars.rubric.overall_score | default:?}}/10\n{{vars.rubric | lines}}",
    "title": "Post scorecard in the thread",
    "tag": "scorecard:{{vars.convo.first.id}}",
    "edit": true
   },
   {
    "id": "b_q",
    "type": "branch",
    "title": "A closing call by phone with no booking?"
   },
   {
    "id": "l_opts",
    "type": "lookup",
    "query": "appointments_for_contact",
    "params": {
     "kind": "closing",
     "status_not": "cancelled",
     "starts_since": "{{recording.started_at}} -14d",
     "starts_until": "{{recording.started_at}} +14d",
     "order": "starts_at"
    },
    "into": "options",
    "title": "Their closing calls booked in the two weeks either side"
   },
   {
    "id": "q_which",
    "type": "slack_post",
    "channel": "{{slack.channel.attention}}",
    "fallback_channel": [
     "{{slack.channel.ops}}",
     "{{slack.channel.calls}}"
    ],
    "as": {
     "name": "Which booking was this call?",
     "icon": ":grey_question:"
    },
    "tag": "closing-which:{{vars.convo.first.id}}",
    "offer": [
     "one",
     "two",
     "three",
     "x"
    ],
    "template": "{{recording.closer.name | default:A closer}} had a {{vars.convo.total_min | default:?}}-minute call{{vars.parts_line}} with <https://app.gohighlevel.com/v2/location/{{crm.location_id}}/contacts/detail/{{contact.ghl_contact_id | default:}}|{{contact.name | default:Unknown}}> ({{recording.started_at | date_company}}) that lines up with none of their bookings. Which booking was it?\n{{vars.options.items | each:\"{{number}}. {{item.starts_at | date_company}} with {{item.closer | default:no closer}} ({{item.status}})\" | join:\"\\n\" | default:They have no closing call booked in the two weeks around it.}}\nTap 1️⃣ 2️⃣ or 3️⃣ for that booking (the first three), or ❌ if it was none of them. Nothing is marked until someone does; the question closes in two days.",
    "title": "Ask which booking the call was"
   },
   {
    "id": "w_which",
    "type": "wait_for_reaction",
    "of": "tag:closing-which:{{vars.convo.first.id}}",
    "emojis": [
     "one",
     "two",
     "three",
     "x"
    ],
    "timeout": "2d",
    "title": "Wait two days for the tap"
   },
   {
    "id": "v_pick",
    "type": "set_var",
    "key": "chosen",
    "value": "{{reaction.reaction | default:}}",
    "pick": {
     "one": "{{vars.options.items.0.id | default:}}",
     "two": "{{vars.options.items.1.id | default:}}",
     "three": "{{vars.options.items.2.id | default:}}"
    },
    "else_value": ""
   },
   {
    "id": "b_pick",
    "type": "branch",
    "title": "Did someone pick a booking?"
   },
   {
    "id": "rec_link",
    "type": "record",
    "event": "call.closing",
    "appointment": "{{vars.chosen}}",
    "start": true,
    "data": {
     "recording_id": "{{recording.id}}",
     "external_id": "{{recording.external_id}}",
     "conversation": "{{vars.convo.key}}",
     "linked_by": "{{reaction.user_name | default:}}"
    },
    "title": "Link it: this workflow runs again on that booking (marks it showed, edits the review)"
   },
   {
    "id": "q_done",
    "type": "slack_post",
    "channel": "{{slack.channel.attention}}",
    "fallback_channel": [
     "{{slack.channel.ops}}",
     "{{slack.channel.calls}}"
    ],
    "as": {
     "name": "Which booking was this call?",
     "icon": ":grey_question:"
    },
    "thread_of": "tag:closing-which:{{vars.convo.first.id}}",
    "thread_only": true,
    "unreact": {
     "of": "tag:closing-which:{{vars.convo.first.id}}",
     "emojis": [
      "one",
      "two",
      "three",
      "x"
     ]
    },
    "template": "Linked to the booking, per {{reaction.user_name | default:the team}}; it is marked showed and the review is updated.",
    "title": "Say who linked it, in the question's thread"
   },
   {
    "id": "q_none",
    "type": "slack_post",
    "channel": "{{slack.channel.attention}}",
    "fallback_channel": [
     "{{slack.channel.ops}}",
     "{{slack.channel.calls}}"
    ],
    "as": {
     "name": "Which booking was this call?",
     "icon": ":grey_question:"
    },
    "thread_of": "tag:closing-which:{{vars.convo.first.id}}",
    "thread_only": true,
    "unreact": {
     "of": "tag:closing-which:{{vars.convo.first.id}}",
     "emojis": [
      "one",
      "two",
      "three",
      "x"
     ]
    },
    "template": "{{reaction.user_name | prefix:Not linked: none of these, per | default:Nobody answered in two days, so nothing was linked}}.",
    "title": "Say it stays unlinked, in the question's thread"
   },
   {
    "id": "x_linked",
    "type": "exit",
    "reason": "linked_by_the_team"
   },
   {
    "id": "x_unlinked",
    "type": "exit",
    "reason": "recorded_unlinked"
   },
   {
    "id": "x1",
    "type": "exit",
    "reason": "recorded"
   },
   {
    "id": "v_disp",
    "type": "set_var",
    "title": "A close the AI hears is pending until cash is collected (D236)",
    "key": "disp",
    "value": "{{vars.outcome.disposition | default:}}",
    "pick": {
     "closed_won": "close_pending"
    },
    "else_value": "{{vars.outcome.disposition | default:}}"
   },
   {
    "id": "b_cl",
    "type": "branch",
    "title": "A client's call? (cash collected or a close filed before it)"
   },
   {
    "id": "n_cl",
    "type": "note",
    "template": "CURRENT SITUATION: {{vars.notes.prospect_situation | default:—}}\n\nPAINS: {{vars.notes.pain | join:\" \" | default:—}}\n\nGOALS: {{vars.notes.desire | join:\" \" | default:—}}\n\nOBJECTIONS: {{vars.notes.objections | each:\"{{item.objection}}\" | join:\", \" | default:None}}\n\nNEXT STEPS: {{vars.notes.next_step | default:—}} {{vars.notes.next_step_date | date_company:ccc LLL d | prefix:by}}\n\nFathom recording: {{recording.share_url | default:—}}",
    "title": "A client's call: the note only (D236)",
    "key": "review:{{vars.convo.key}}"
   },
   {
    "id": "x_cl",
    "type": "exit",
    "reason": "client_call"
   },
   {
    "id": "k7",
    "type": "set_var",
    "key": "call_key",
    "value": "{{appointment.slot_key}}"
   },
   {
    "id": "k6",
    "type": "set_var",
    "key": "appt_line",
    "value": "*Follow-up* on the call of {{appointment.starts_at | date_company}}: its Sales Call is updated"
   },
   {
    "id": "b_r",
    "type": "branch",
    "title": "A booking to write the Sales Call on?"
   }
  ],
  "edges": [
   {
    "from": "t1",
    "to": "l_conv"
   },
   {
    "from": "t2",
    "to": "l_conv"
   },
   {
    "from": "l_conv",
    "to": "a1"
   },
   {
    "from": "a1",
    "to": "c1"
   },
   {
    "from": "c1",
    "to": "a3"
   },
   {
    "from": "v_parts",
    "to": "v_rec"
   },
   {
    "from": "v_rec",
    "to": "b1"
   },
   {
    "from": "b1",
    "to": "k7",
    "when": {
     "and": [
      {
       "exists": "appointment.id"
      },
      {
       "eq": [
        "{{event.placed}}",
        "follow_up"
       ]
      }
     ]
    },
    "label": "a follow-up on a sale already held"
   },
   {
    "from": "b1",
    "to": "o1",
    "when": {
     "exists": "appointment.id"
    },
    "label": "appointment matched"
   },
   {
    "from": "b1",
    "to": "k5",
    "when": {
     "and": [
      {
       "or": [
        {
         "eq": [
          "{{event._type}}",
          "call.closing"
         ]
        },
        {
         "eq": [
          "{{event.placed}}",
          "unbooked"
         ]
        }
       ]
      },
      {
       "not": {
        "exists": "appointment.id"
       }
      }
     ]
    },
    "label": "no booking lines up: the team is asked"
   },
   {
    "from": "b1",
    "to": "k2",
    "else": true,
    "label": "no appointment matched"
   },
   {
    "from": "o1",
    "to": "o2"
   },
   {
    "from": "o2",
    "to": "o4"
   },
   {
    "from": "k1",
    "to": "k3"
   },
   {
    "from": "k2",
    "to": "k4"
   },
   {
    "from": "k3",
    "to": "s1"
   },
   {
    "from": "k4",
    "to": "s1"
   },
   {
    "from": "s1",
    "to": "s2"
   },
   {
    "from": "r1",
    "to": "n1"
   },
   {
    "from": "n1",
    "to": "b_q"
   },
   {
    "from": "o4",
    "to": "k1"
   },
   {
    "from": "k5",
    "to": "s1"
   },
   {
    "from": "b_q",
    "to": "l_opts",
    "when": {
     "and": [
      {
       "or": [
        {
         "eq": [
          "{{event._type}}",
          "call.closing"
         ]
        },
        {
         "eq": [
          "{{event.placed}}",
          "unbooked"
         ]
        }
       ]
      },
      {
       "not": {
        "exists": "appointment.id"
       }
      }
     ]
    },
    "label": "ask which booking"
   },
   {
    "from": "b_q",
    "to": "x1",
    "else": true,
    "label": "linked, or a meeting recording"
   },
   {
    "from": "l_opts",
    "to": "q_which"
   },
   {
    "from": "q_which",
    "to": "w_which"
   },
   {
    "from": "w_which",
    "to": "v_pick"
   },
   {
    "from": "v_pick",
    "to": "b_pick"
   },
   {
    "from": "b_pick",
    "to": "rec_link",
    "when": {
     "neq": [
      "{{vars.chosen}}",
      ""
     ]
    },
    "label": "a booking was picked"
   },
   {
    "from": "b_pick",
    "to": "q_none",
    "else": true,
    "label": "none of them, or nobody answered"
   },
   {
    "from": "rec_link",
    "to": "q_done"
   },
   {
    "from": "q_done",
    "to": "x_linked"
   },
   {
    "from": "q_none",
    "to": "x_unlinked"
   },
   {
    "from": "a3",
    "to": "v_disp"
   },
   {
    "from": "v_disp",
    "to": "a2"
   },
   {
    "from": "a2",
    "to": "b_cl"
   },
   {
    "from": "b_cl",
    "to": "n_cl",
    "when": {
     "eq": [
      "{{event.placed}}",
      "client"
     ]
    },
    "label": "a client's call"
   },
   {
    "from": "b_cl",
    "to": "v_parts",
    "else": true,
    "label": "a sales call"
   },
   {
    "from": "n_cl",
    "to": "x_cl"
   },
   {
    "from": "k7",
