{
 "workflow": "triage-pre-call",
 "name": "Triage pre-call",
 "create": {
  "stage": "pre_call",
  "sort": 10,
  "takesOver": "pre-call-sequence"
 },
 "definition": {
  "schema": 1,
  "reentry": "once_per_appointment",
  "reentry_key": "{{appointment.starts_at}}",
  "premise": {
   "check": "appointment_in_future"
  },
  "nodes": [
   {
    "id": "t1",
    "type": "trigger",
    "event": "appointment.booked",
    "match": {
     "eq": [
      "{{appointment.term.name}}",
      "Triage call"
     ]
    },
    "title": "A Triage call booked"
   },
   {
    "id": "t2",
    "type": "trigger",
    "event": "appointment.rescheduled",
    "match": {
     "eq": [
      "{{appointment.term.name}}",
      "Triage call"
     ]
    },
    "title": "A Triage call moved"
   },
   {
    "id": "c0",
    "type": "check",
    "title": "Wait for GHL to have the person before the receipts",
    "when": {
     "exists": "contact.ghl_contact_id"
    },
    "retry": {
     "every": "2m",
     "for": "1h"
    },
    "else_exit": "no_crm_id",
    "else_pause": "contact has no CRM id yet: GHL did not have the person an hour after the booking"
   },
   {
    "id": "s1",
    "type": "send_sms",
    "kind": "transactional",
    "template": "Hi {{contact.first_name}}, you're booked for your free 15-minute call on {{appointment.starts_at | date:\"cccc, LLL d 'at' h:mm a ZZZZ\"}}. My teammate will be calling you. Reply YES to confirm, or reply here if you need a different time.",
    "validity": {
     "anchor": "before_event",
     "min_lead": "15m"
    },
    "on_stale": "skip",
    "title": "Booking text"
   },
   {
    "id": "v_lead",
    "type": "set_var",
    "key": "lead_at_day_before",
    "value": "{{appointment.starts_at | hours_until}}",
    "title": "How far off the call is when the day-before wait starts"
   },
   {
    "id": "r24",
    "type": "wait",
    "rule": {
     "anchor": "appointment.starts_at",
     "offset": "-24h",
     "tz": "contact",
     "earliest": "08:00",
     "latest": "21:00",
     "window": "before"
    }
   },
   {
    "id": "m24s",
    "type": "send_sms",
    "template": "Hi {{contact.first_name}}, quick reminder about your dating strategy session tomorrow at {{appointment.starts_at | date:\"h:mm a ZZZZ\"}}. It's only 15 minutes, so find a spot where you can talk freely.",
    "validity": {
     "anchor": "before_event",
     "min_lead": "18h"
    },
    "on_stale": "skip",
    "title": "The day before",
    "only_if": {
     "or": [
      {
       "not": {
        "exists": "vars.lead_at_day_before"
       }
      },
      {
       "gt": [
        "{{vars.lead_at_day_before}}",
        24
       ]
      }
     ]
    }
   },
   {
    "id": "r1",
    "type": "wait",
    "rule": {
     "anchor": "appointment.starts_at",
     "offset": "-1h",
     "tz": "contact",
     "earliest": "07:00",
     "window": "before"
    }
   },
   {
    "id": "m1",
    "type": "send_sms",
    "template": "{{contact.first_name}}, your call is {{appointment.starts_at | relative:hours}} ({{appointment.starts_at | date:\"h:mm a ZZZZ\"}}). Keep your phone close.",
    "validity": {
     "anchor": "before_event",
     "min_lead": "15m"
    },
    "on_stale": "skip",
    "title": "An hour before",
    "only_if": {
     "or": [
      {
       "not": {
        "exists": "reply.last_outbound.at"
       }
      },
      {
       "lt": [
        "{{reply.last_outbound.at | hours_until}}",
        -1
       ]
      }
     ]
    }
   },
   {
    "id": "x_done",
    "type": "exit",
    "reason": "done"
   }
  ],
  "edges": [
   {
    "from": "t1",
    "to": "c0"
   },
   {
    "from": "t2",
    "to": "c0"
   },
   {
    "from": "c0",
    "to": "s1"
   },
   {
    "from": "r24",
    "to": "m24s"
   },
   {
    "from": "m24s",
    "to": "r1"
   },
   {
    "from": "r1",
    "to": "m1"
   },
   {
    "from": "m1",
    "to": "x_done"
   },
   {
    "from": "s1",
    "to": "v_lead"
   },
   {
    "from": "v_lead",
    "to": "r24"
   }
  ]
 },
 "note": "the Triage call's pre-call texts (D208): the booking text, a day before and an hour before, and nothing else; a reply is a person's to answer in the CRM; no emails"
}
