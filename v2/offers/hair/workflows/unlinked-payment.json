{
  "schema": 2,
  "id": "unlinked-payment",
  "name": "Unlinked payment",
  "description": "A payment that matched nobody is posted in the alerts channel with a \"Link to a contact\" button.",
  "origin": {
    "template": "payment-unlinked",
    "version": 3
  },
  "reentry": {
    "policy": "always"
  },
  "delivery": {
    "kind": "human",
    "whenStale": "skip"
  },
  "nodes": [
    {
      "id": "t1",
      "type": "trigger@1",
      "title": "A payment matched nobody",
      "on": {
        "event": "payment.unlinked"
      }
    },
    {
      "id": "n1",
      "type": "message@1",
      "title": "Tell the team a payment matched nobody",
      "to": {
        "slack": {
          "channel": "{{setting.slack.channel.alerts}}",
          "fallbackChannel": "{{setting.slack.channel.bookings}}"
        }
      },
      "content": "unlinked_payment.n1",
      "buttons": [
        {
          "action": "link_payment",
          "value": "{{event.payment_id}}",
          "style": "primary"
        }
      ]
    },
    {
      "id": "x1",
      "type": "end@1",
      "title": "Stop: told",
      "reason": "told"
    }
  ],
  "edges": [
    {
      "from": "t1",
      "to": "n1"
    },
    {
      "from": "n1",
      "to": "x1"
    }
  ]
}
