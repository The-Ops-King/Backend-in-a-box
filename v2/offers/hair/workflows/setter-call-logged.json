{
  "schema": 2,
  "id": "setter-call-logged",
  "name": "Setter call logged",
  "description": "A connected dialer call of a minute or more with a transcript: Jev reads its kind; a closing call goes to Sales call recorded; a setting or confirmation call gets AI notes, Jev's read of what it achieved (a booking through a setter link makes it Set), a Discovery Call record, a CRM note and a post, and, when Jev is unsure, a question to the team; then the follow-up task, DQ tag and lost cards when acting is on.",
  "origin": {
    "template": "setter-call-logged",
    "version": 9
  },
  "reentry": {
    "policy": "always"
  },
  "premise": {
    "label": "The contact is still in the CRM",
    "holds": {
      "exists": "contact.id"
    },
    "endReason": "contact_gone"
  },
  "delivery": {
    "kind": "human",
    "whenStale": "skip"
  },
  "nodes": [
    {
      "id": "t1",
      "type": "trigger@1",
      "title": "A dialer call came in from GHL — kind of recording is a phone call and the call connected",
      "on": {
        "event": "call.logged",
        "match": {
          "and": [
            {
              "eq": [
                "{{recording.kind}}",
                "phone"
              ]
            },
            {
              "eq": [
                "{{recording.connected}}",
                true
              ]
            }
          ]
        }
      }
    },
    {
      "id": "v1",
      "type": "set@1",
      "title": "Remember min seconds = 60",
      "var": "min_seconds",
      "value": 60
    },
    {
      "id": "l_conv",
      "type": "action@1",
      "title": "The whole conversation: the same setter's calls to them, each starting within the company's gap (15 minutes) of the last one ending",
      "action": "facts.lookup",
      "params": {
        "query": "call_conversation",
        "params": {
          "gap_min": "{{setting.calls.conversation_gap_min}}",
          "recording_id": "{{recording.id}}"
        }
      },
      "into": "convo"
    },
    {
      "id": "c1",
      "type": "branch@1",
      "title": "Check the whole conversation's length (seconds) is at least the minimum call length (seconds)"
    },
    {
      "id": "c1_x",
      "type": "end@1",
      "title": "Stop: too_short",
      "reason": "too_short"
    },
    {
      "id": "c2",
      "type": "branch@1",
      "title": "Check there is a transcript"
    },
    {
      "id": "c2_x",
      "type": "end@1",
      "title": "Stop: no_transcript",
      "reason": "no_transcript"
    },
    {
      "id": "a1",
      "type": "action@1",
      "title": "Jev: setting, confirmation or closing call?",
      "action": "ai.classify",
      "params": {
        "input": "{{vars.convo.transcript_text}}",
        "prompt": "prompts.setter_call_logged.a1",
        "options": [
          "other",
          "closing",
          "setting",
          "confirmation"
        ],
        "threshold": 0.8,
        "ambiguityMax": 0.8,
        "unclear": "other"
      },
      "into": "call_type"
    },
    {
      "id": "b_kind",
      "type": "branch@1",
      "title": "What kind of call?"
    },
    {
      "id": "l_book",
      "type": "action@1",
      "title": "Their booked call with this closer, starting within an hour of the call",
      "action": "facts.lookup",
      "params": {
        "query": "appointments_for_contact",
        "params": {
          "kind": "closing",
          "order": "starts_at",
          "closer": "{{recording.caller.ghl_user_id | optional}}",
          "status_not": "cancelled",
          "starts_since": "{{vars.convo.first.started_at | minus:60m}}",
          "starts_until": "{{vars.convo.first.started_at | plus:60m}}"
        }
      },
      "into": "closing_booking"
    },
    {
      "id": "a2",
      "type": "action@1",
      "title": "AI reads the whole conversation's transcript with the “setter call notes” prompt",
      "action": "ai.summarize",
      "params": {
        "prompt": "prompts.setter_call_notes",
        "input": "{{vars.convo.transcript_text}}",
        "format": "json"
      },
      "into": "notes"
    },
    {
      "id": "x_other",
      "type": "end@1",
      "title": "Stop: not a setting call",
      "reason": "not_a_setting_call"
    },
    {
      "id": "v_link",
      "type": "set@1",
      "title": "Exactly one booking lines up (none or several: the closer's workflow asks which)",
      "var": "booking_id",
      "value": {
        "$if": {
          "eq": [
            "{{vars.closing_booking.count}}",
            1
          ]
        },
        "then": "{{vars.closing_booking.first.id}}",
        "else": ""
      }
    },
    {
      "id": "v_parts",
      "type": "set@1",
      "title": "A call in parts says so",
      "var": "parts_line",
      "value": {
        "$if": {
          "gt": [
            "{{vars.convo.count}}",
            1
          ]
        },
        "then": " ({{vars.convo.count}} parts)",
        "else": ""
      }
    },
    {
      "id": "rec_close",
      "type": "action@1",
      "title": "A closing call: Sales call recorded takes it from here",
      "action": "facts.record",
      "params": {
        "type": "call.closing",
        "data": {
          "parts": "{{vars.convo.count}}",
          "closer": "{{recording.caller.name | optional}}",
          "linked": "{{vars.booking_id | optional}}",
          "external_id": "{{recording.external_id}}",
          "conversation": "{{vars.convo.key}}",
          "recording_id": "{{recording.id}}"
        },
        "startsWorkflows": true,
        "appointment": "{{vars.booking_id | optional}}"
      },
      "onFailure": "hold"
    },
    {
      "id": "b_type",
      "type": "branch@1",
      "title": "A setting call: what did it achieve?"
    },
    {
      "id": "x_close",
      "type": "end@1",
      "title": "Stop: closing call",
      "reason": "closing_call"
    },
    {
      "id": "a3",
      "type": "action@1",
      "title": "Jev: set, follow up, DQ or not interested?",
      "action": "ai.classify",
      "params": {
        "input": "{{vars.convo.transcript_text}}",
        "prompt": "prompts.setter_call_logged.a3",
        "options": [
          "dq",
          "set",
          "follow_up",
          "not_interested",
          "unclear"
        ],
        "threshold": 0.7,
        "ambiguityMax": 0.8,
        "unclear": "unclear"
      },
      "into": "setter_result"
    },
    {
      "id": "v_cline",
      "type": "set@1",
      "title": "Remember outcome line = Confirmation call (no result read)",
      "var": "outcome_line",
      "value": "Confirmation call (no result read)"
    },
    {
      "id": "v_conf",
      "type": "set@1",
      "title": "Remember jev confidence = [reply intent confidence]",
      "var": "jev_confidence",
      "value": "{{vars.setter_result.confidence | percent}}"
    },
    {
      "id": "l_now",
      "type": "action@1",
      "title": "Has a later part of this conversation come in meanwhile?",
      "action": "facts.lookup",
      "params": {
        "query": "call_conversation",
        "params": {
          "gap_min": "{{setting.calls.conversation_gap_min}}",
          "recording_id": "{{recording.id}}"
        }
      },
      "into": "convo_now"
    },
    {
      "id": "v_guess",
      "type": "set@1",
      "title": "Remember jev guesses = [top guesses]",
      "var": "jev_guesses",
      "value": "{{vars.setter_result.guesses | first:3 | each:\"{{item.value}} {{item.confidence | percent}}%\" | join:\", \" | words | default:none}}"
    },
    {
      "id": "c_latest",
      "type": "branch@1",
      "title": "Check there are no later parts already in"
    },
    {
      "id": "c_latest_x",
      "type": "end@1",
      "title": "Stop: read_with_a_later_part",
      "reason": "read_with_a_later_part"
    },
    {
      "id": "w_post",
      "type": "wait@1",
      "title": "Post as soon as a booking lands through a setter link (one made during the call counts at once), else 15 minutes after hang-up",
      "event": {
        "type": "appointment.booked",
        "about": "contact",
        "match": {
          "and": [
            {
              "eq": [
                "{{event.appointment.booking_source}}",
                "setter"
              ]
            },
            {
              "lte": [
                "{{event.appointment.booked_at}}",
                "{{recording.set_until}}"
              ]
            }
          ]
        },
        "since": "{{vars.convo.first.started_at}}"
      },
      "into": "booked",
      "until": {
        "anchor": "recording.ended_at",
        "offset": "+15m",
        "zone": "offer"
      },
      "fitSendWindow": false
    },
    {
      "id": "w_post_matched",
      "type": "set@1",
      "title": "Whether a booking through a setter link came",
      "var": "booked_matched",
      "value": {
        "$if": {
          "exists": "vars.booked.type"
        },
        "then": true,
        "else": false
      }
    },
    {
      "id": "r1",
      "type": "action@1",
      "title": "The Discovery Call record (one per conversation)",
      "action": "crm.upsert_record",
      "params": {
        "object": "custom_objects.discovery_call",
        "properties": {
          "setter": "{{recording.caller.name | optional}}",
          "outcome": "{{recording.status}}",
          "direction": "{{recording.direction}}",
          "contact_id": "{{contact.ghl_contact_id | optional}}",
          "call_result": "{{vars.result_key | optional}}",
          "external_id": "{{vars.convo.key}}",
          "occurred_at": "{{vars.convo.first.started_at | offer_date:medium}}",
          "duration_sec": "{{vars.convo.total_sec}}",
          "display_label": "{{contact.name | default:Unknown}} — {{vars.convo.first.started_at | offer_date:medium}}{{vars.parts_line | optional}}",
          "recording_url": "{{recording.url | optional}}"
        },
        "ifMissing": "create",
        "key": "{{vars.convo.key}}",
        "owner": "{{recording.caller.ghl_user_id | optional}}"
      },
      "into": "r1_record",
      "onFailure": "skip"
    },
    {
      "id": "r1_written",
      "type": "branch@1",
      "title": "Was the record written? (its links need its id)"
    },
    {
      "id": "r1_rel1",
      "type": "action@1",
      "title": "Link the record (1 of 1)",
      "action": "crm.relate_records",
      "params": {
        "association": "{{setting.crm.assoc_discovery_call_contact}}",
        "first": "{{contact.ghl_contact_id | optional}}",
        "second": "{{vars.r1_record.id}}"
      }
    },
    {
      "id": "v_by",
      "type": "set@1",
      "title": "Without a booking, Jev's read (a Set read with no booking goes to the team)",
      "var": "decided_by",
      "value": {
        "$if": {
          "in": [
            "{{vars.setter_result.value}}",
            [
              "follow_up",
              "dq",
              "not_interested"
            ]
          ]
        },
        "then": "jev",
        "else": ""
      }
    },
    {
      "id": "m1",
      "type": "action@1",
      "title": "Leave an internal note",
      "action": "crm.add_note",
      "params": {
        "content": "setter_call_logged.m1"
      }
    },
    {
      "id": "v_by30",
      "type": "set@1",
      "title": "A booking through a setter link: Set, whatever Jev read",
      "var": "decided_by",
      "value": {
        "$if": {
          "eq": [
            "{{vars.booked_matched}}",
            true
          ]
        },
        "then": "booking",
        "else": "{{vars.decided_by | optional}}"
      }
    },
    {
      "id": "s1",
      "type": "message@1",
      "title": "Post the setter call in Slack (a later part edits the same post)",
      "to": {
        "slack": {
          "channel": "{{setting.slack.channel.setter_calls}}"
        }
      },
      "content": "setter_call_logged.s1",
      "remember": "setter-call:{{vars.convo.key}}",
      "edit": true
    },
    {
      "id": "v_res",
      "type": "set@1",
      "title": "Remember result, picked by [who decided the result]",
      "var": "result",
      "value": {
        "$pick": "{{vars.decided_by | optional}}",
        "cases": {
          "jev": "{{vars.setter_result.value}}",
          "booking": "set"
        },
        "else": ""
      }
    },
    {
      "id": "w_late",
      "type": "wait@1",
      "title": "Until the Set window closes (the company's 30 minutes after hang-up): a booking through a setter link makes it Set",
      "event": {
        "type": "appointment.booked",
        "about": "contact",
        "match": {
          "and": [
            {
              "eq": [
                "{{event.appointment.booking_source}}",
                "setter"
              ]
            },
            {
              "lte": [
                "{{event.appointment.booked_at}}",
                "{{recording.set_until}}"
              ]
            }
          ]
        },
        "since": "{{vars.convo.first.started_at}}"
      },
      "into": "late",
      "until": {
        "anchor": "recording.set_until",
        "zone": "offer"
      },
      "fitSendWindow": false
    },
    {
      "id": "w_late_matched",
      "type": "set@1",
      "title": "Whether a booking through a setter link came in the Set window",
      "var": "late_matched",
      "value": {
        "$if": {
          "exists": "vars.late.type"
        },
        "then": true,
        "else": false
      }
    },
    {
      "id": "v_agree",
      "type": "set@1",
      "title": "Remember jev agreed = true",
      "var": "jev_agreed",
      "value": {
        "$if": {
          "eq": [
            "{{vars.setter_result.value}}",
            "{{vars.result | optional}}"
          ]
        },
        "then": true,
        "else": false
      }
    },
    {
      "id": "l_now2",
      "type": "action@1",
      "title": "Has a later part of this conversation come in meanwhile?",
      "action": "facts.lookup",
      "params": {
        "query": "call_conversation",
        "params": {
          "gap_min": "{{setting.calls.conversation_gap_min}}",
          "recording_id": "{{recording.id}}"
        }
      },
      "into": "convo_now"
    },
    {
      "id": "v_ask",
      "type": "set@1",
      "title": "Remember asking = true",
      "var": "asking",
      "value": {
        "$if": {
          "eq": [
            "{{vars.decided_by | optional}}",
            ""
          ]
        },
        "then": true,
        "else": false
      }
    },
    {
      "id": "c_latest2",
      "type": "branch@1",
      "title": "A later part's run has the whole conversation (its post, its record, its question)"
    },
    {
      "id": "c_latest2_x",
      "type": "end@1",
      "title": "Stop: read_with_a_later_part",
      "reason": "read_with_a_later_part"
    },
    {
      "id": "a4",
      "type": "action@1",
      "title": "Jev: why disqualified?",
      "action": "ai.classify",
      "params": {
        "input": "{{vars.convo.transcript_text}}",
        "prompt": "prompts.setter_call_logged.a4",
        "options": [
          "age",
          "geo",
          "other",
          "budget",
          "medical",
          "timeline",
          "competitor",
          "no_problem",
          "bad_contact"
        ],
        "threshold": 0.6,
        "ambiguityMax": 0.8,
        "unclear": "other"
      },
      "into": "dq_reason",
      "onFailure": "skip"
    },
    {
      "id": "b_late",
      "type": "branch@1",
      "title": "Did a booking through a setter link land in the Set window?"
    },
    {
      "id": "v_dqtag",
      "type": "set@1",
      "title": "Remember dq tag, picked by [Jev's DQ reason]",
      "var": "dq_tag",
      "value": {
        "$pick": "{{vars.dq_reason.value | optional}}",
        "cases": {
          "age": "dq-age",
          "geo": "dq-geo",
          "budget": "dq-budget",
          "medical": "dq-medical",
          "timeline": "dq-timeline",
          "competitor": "dq-competitor",
          "no_problem": "dq-no-problem",
          "bad_contact": "dq-bad-contact"
        },
        "else": "dq"
      }
    },
    {
      "id": "lt_res",
      "type": "set@1",
      "title": "Remember result = set",
      "var": "result",
      "value": "set"
    },
    {
      "id": "b_ask",
      "type": "branch@1",
      "title": "Was Jev sure?"
    },
    {
      "id": "rec_read",
      "type": "action@1",
      "title": "Log Jev's read, to score it later",
      "action": "facts.record",
      "params": {
        "type": "setter_call.result",
        "data": {
          "acts": "{{setting.setter_result.act}}",
          "parts": "{{vars.convo.count}}",
          "result": "{{vars.result | optional}}",
          "setter": "{{recording.caller.name | optional}}",
          "booked_at": "{{vars.booked.appointment.booked_at | optional}}",
          "dq_reason": "{{vars.dq_reason.value | optional}}",
          "predicted": "{{vars.setter_result.value}}",
          "decided_by": "{{vars.decided_by | optional}}",
          "jev_agreed": "{{vars.jev_agreed}}",
          "external_id": "{{vars.convo.key}}",
          "top_guesses": "{{vars.jev_guesses}}",
          "recording_id": "{{vars.convo.first.id}}",
          "set_by_booking": "{{vars.booked_matched | default:false}}",
          "predicted_confidence": "{{vars.jev_confidence}}"
        },
        "startsWorkflows": false
      },
      "onFailure": "hold"
    },
    {
      "id": "lt_by",
      "type": "set@1",
      "title": "Remember decided by = booking",
      "var": "decided_by",
      "value": "booking"
    },
    {
      "id": "q1",
      "type": "ask@1",
      "title": "Ask the setters: set, follow up, DQ or not interested?",
      "to": {
        "channel": "{{setting.slack.channel.setter_calls}}",
        "fallbackChannel": "{{setting.slack.channel.ops}}"
      },
      "content": "setter_call_logged.q1",
      "answers": {
        "reactions": [
          "white_check_mark",
          "repeat",
          "x",
          "no_entry_sign"
        ]
      },
      "into": "reaction",
      "then": "listen",
      "until": {
        "anchor": "now",
        "offset": "+2d",
        "zone": "offer"
      },
      "remember": "setter-result:{{vars.convo.key}}",
      "onFailure": "skip"
    },
    {
      "id": "k_task",
      "type": "branch@1",
      "title": "When is the next business day?"
    },
    {
      "id": "k_task_3d",
      "type": "action@1",
      "title": "Open the call-back task, due in 3d",
      "action": "crm.create_task",
      "params": {
        "title": "setter_call_logged.k_task.title",
        "body": "setter_call_logged.k_task.body",
        "due": "3d",
        "assignTo": "{{recording.caller.ghl_user_id | optional}}"
      }
    },
    {
      "id": "k_task_2d",
      "type": "action@1",
      "title": "Open the call-back task, due in 2d",
      "action": "crm.create_task",
      "params": {
        "title": "setter_call_logged.k_task.title",
        "body": "setter_call_logged.k_task.body",
        "due": "2d",
        "assignTo": "{{recording.caller.ghl_user_id | optional}}"
      }
    },
    {
      "id": "k_task_1d",
      "type": "action@1",
      "title": "Open the call-back task, due in 1d",
      "action": "crm.create_task",
      "params": {
        "title": "setter_call_logged.k_task.title",
        "body": "setter_call_logged.k_task.body",
        "due": "1d",
        "assignTo": "{{recording.caller.ghl_user_id | optional}}"
      }
    },
    {
      "id": "v_due",
      "type": "set@1",
      "title": "Next business day",
      "var": "task_due",
      "value": {
        "$pick": "{{now | offer_date:weekday}}",
        "cases": {
          "Friday": "+3d",
          "Saturday": "+2d"
        },
        "else": "+1d"
      }
    },
    {
      "id": "lt_agree",
      "type": "set@1",
      "title": "Remember jev agreed = true",
      "var": "jev_agreed",
      "value": {
        "$if": {
          "eq": [
            "{{vars.setter_result.value}}",
            "set"
          ]
        },
        "then": true,
        "else": false
      }
    },
    {
      "id": "k_tag",
      "type": "action@1",
      "title": "Tags “+[the DQ tag]”",
      "action": "crm.add_tag",
      "params": {
        "tags": [
          "{{vars.dq_tag}}"
        ]
      }
    },
    {
      "id": "v_mode",
      "type": "set@1",
      "title": "Remember act word = *Next:*",
      "var": "act_word",
      "value": {
        "$if": {
          "eq": [
            "{{setting.setter_result.act}}",
            true
          ]
        },
        "then": "*Next:*",
        "else": "*Would have (actions are off):*"
      }
    },
    {
      "id": "lt_ask",
      "type": "set@1",
      "title": "Remember asking = false",
      "var": "asking",
      "value": false
    },
    {
      "id": "w_hold",
      "type": "wait@1",
      "title": "Keep the question open two days",
      "until": {
        "anchor": "now",
        "offset": "+2d",
        "zone": "offer"
      }
    },
    {
      "id": "tv_res",
      "type": "set@1",
      "title": "Remember result, picked by [the tap]",
      "var": "result",
      "value": {
        "$pick": "{{vars.reaction.value | optional}}",
        "cases": {
          "x": "dq",
          "repeat": "follow_up",
          "no_entry_sign": "not_interested",
          "white_check_mark": "set"
        },
        "else": ""
      }
    },
    {
      "id": "ru1",
      "type": "action@1",
      "title": "Record that nobody answered in two days",
      "action": "facts.record",
      "params": {
        "type": "intent.unanswered",
        "data": {
          "domain": "setter_call_result",
          "predicted": "{{vars.setter_result.value}}",
