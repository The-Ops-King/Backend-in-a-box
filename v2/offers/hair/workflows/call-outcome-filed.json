{
  "schema": 2,
  "id": "call-outcome-filed",
  "name": "Call outcome filed",
  "description": "The closer filed how a closing call went (or it was marked no-show): the tags, the booking post's reactions and thread line, the setter and closer cards, the Sales Call record and the deal follow the answer, and a changed answer takes back what the earlier one did.",
  "origin": {
    "template": "call-outcome",
    "version": 11
  },
  "reentry": {
    "policy": "always"
  },
  "delivery": {
    "kind": "human",
    "whenStale": "skip"
  },
  "nodes": [
    {
      "id": "t1",
      "type": "trigger@1",
      "title": "The call's outcome is filed — the source is a closer's form and call type is closing call",
      "on": {
        "event": "appointment.outcome",
        "match": {
          "and": [
            {
              "eq": [
                "{{event.outcome_source}}",
                "disposition"
              ]
            },
            {
              "eq": [
                "{{appointment.term.category}}",
                "closing"
              ]
            }
          ]
        }
      }
    },
    {
      "id": "t2",
      "type": "trigger@1",
      "title": "An appointment's status changed — new status is no-show and call type is closing call",
      "on": {
        "event": "appointment.status_changed",
        "match": {
          "and": [
            {
              "eq": [
                "{{event.status.to}}",
                "noshow"
              ]
            },
            {
              "eq": [
                "{{appointment.term.category}}",
                "closing"
              ]
            }
          ]
        }
      }
    },
    {
      "id": "u1_key",
      "type": "set@1",
      "title": "What the call's earlier answer tagged: the key to look up",
      "var": "tags_before_key",
      "value": "{{event.previous_outcome | optional}}:{{event.previous_call_outcome | optional}}"
    },
    {
      "id": "u1",
      "type": "set@1",
      "title": "What the call's earlier answer tagged",
      "var": "tags_before",
      "value": {
        "$pick": "{{vars.tags_before_key}}",
        "cases": {
          "noshow:": [
            "stat-no-show",
            "stat-possible-cancel"
          ],
          "showed:": [
            "stat-showed"
          ],
          "showed:lost": [
            "stat-showed",
            "stat-lost"
          ],
          "showed:closed": [
            "stat-showed",
            "stat-closed-won"
          ],
          "showed:deposit": [
            "stat-showed",
            "stat-deposit"
          ],
          "showed:pending": [
            "stat-showed"
          ],
          "showed:follow_up": [
            "stat-showed",
            "stat-follow-up"
          ],
          "showed:unqualified": [
            "stat-showed",
            "stat-disqualified"
          ]
        },
        "else": []
      }
    },
    {
      "id": "g1",
      "type": "message@1",
      "title": "React 👻 on the booking post",
      "to": {
        "slack": {
          "channel": "{{setting.slack.channel.bookings}}"
        }
      },
      "content": "call_outcome_filed.g1",
      "thread": {
        "tag": "appointment:{{appointment.id}}"
      },
      "threadOnly": true,
      "remember": "outcome:{{appointment.id}}"
    },
    {
      "id": "g1_react",
      "type": "action@1",
      "title": "React :ghost: on the post it replies under",
      "action": "slack.react",
      "params": {
        "post": {
          "tag": "appointment:{{appointment.id}}"
        },
        "emojis": [
          "ghost"
        ]
      }
    },
    {
      "id": "g1_undo",
      "type": "branch@1",
      "title": "Which reaction does the earlier answer take back?"
    },
    {
      "id": "g1_undo_white_check_mark",
      "type": "action@1",
      "title": "Take :white_check_mark: off the booking post",
      "action": "slack.unreact",
      "params": {
        "post": {
          "tag": "appointment:{{appointment.id}}"
        },
        "emojis": [
          "white_check_mark"
        ]
      }
    },
    {
      "id": "u2_key",
      "type": "set@1",
      "title": "What this answer tags: the key to look up",
      "var": "tags_now_key",
      "value": "{{event.outcome}}:{{appointment.call_outcome | optional}}"
    },
    {
      "id": "u2",
      "type": "set@1",
      "title": "What this answer tags",
      "var": "tags_now",
      "value": {
        "$pick": "{{vars.tags_now_key}}",
        "cases": {
          "noshow:": [
            "stat-no-show"
          ],
          "showed:": [
            "stat-showed"
          ],
          "showed:lost": [
            "stat-showed",
            "stat-lost"
          ],
          "showed:closed": [
            "stat-showed",
            "stat-closed-won"
          ],
          "showed:deposit": [
            "stat-showed",
            "stat-deposit"
          ],
          "showed:pending": [
            "stat-showed"
          ],
          "showed:follow_up": [
            "stat-showed",
            "stat-follow-up"
          ],
          "showed:unqualified": [
            "stat-showed",
            "stat-disqualified"
          ]
        },
        "else": []
      }
    },
    {
      "id": "g2",
      "type": "action@1",
      "title": "Add tag “stat-no-show”",
      "action": "crm.add_tag",
      "params": {
        "tags": [
          "stat-no-show"
        ]
      }
    },
    {
      "id": "u3_key",
      "type": "set@1",
      "title": "The reaction the earlier answer left that this one takes back: the key to look up",
      "var": "undo_emoji_key",
      "value": "{{event.previous_outcome | optional}}>{{event.outcome}}"
    },
    {
      "id": "u3",
      "type": "set@1",
      "title": "The reaction the earlier answer left that this one takes back",
      "var": "undo_emoji",
      "value": {
        "$pick": "{{vars.undo_emoji_key}}",
        "cases": {
          "noshow>showed": "ghost",
          "showed>noshow": "white_check_mark",
          "noshow>rescheduled": "ghost",
          "showed>rescheduled": "white_check_mark"
        },
        "else": ""
      }
    },
    {
      "id": "gn1",
      "type": "action@1",
      "title": "Setter card → No-Show / Cancel / Reschedule, marked lost (the setter pipeline is won on a show, lost on a no-show; the next booking makes a fresh setter card)",
      "action": "crm.move_deal",
      "params": {
        "pipeline": "{{setting.crm.pipeline_setter}}",
        "stage": "{{setting.crm.stage_setter_cancelled}}",
        "ifMissing": "skip",
        "pick": "latest"
      }
    },
    {
      "id": "gn1_status",
      "type": "action@1",
      "title": "Mark that card lost",
      "action": "crm.set_deal_status",
      "params": {
        "pipeline": "{{setting.crm.pipeline_setter}}",
        "status": "lost"
      }
    },
    {
      "id": "u4",
      "type": "action@1",
      "title": "A changed answer: take off what the earlier answer tagged and this one does not",
      "action": "crm.remove_tag",
      "params": {
        "tags": [
          "{{vars.tags_before}}"
        ]
      }
    },
    {
      "id": "gn2",
      "type": "action@1",
      "title": "Closer card → No Show / Cancelled (move only: they can rebook)",
      "action": "crm.move_deal",
      "params": {
        "pipeline": "{{setting.crm.pipeline_closer}}",
        "stage": "{{setting.crm.stage_closer_cancelled}}",
        "ifMissing": "skip",
        "pick": "latest"
      }
    },
    {
      "id": "gn2_status",
      "type": "action@1",
      "title": "Mark that card open",
      "action": "crm.set_deal_status",
      "params": {
        "pipeline": "{{setting.crm.pipeline_closer}}",
        "status": "open"
      }
    },
    {
      "id": "o_reopen",
      "type": "branch@1",
      "title": "Is the deal lost?"
    },
    {
      "id": "o_reopen_rec",
      "type": "action@1",
      "title": "A changed answer takes the loss back: the opportunity is open again",
      "action": "facts.record",
      "params": {
        "type": "deal.reopened",
        "data": {
          "status": "open",
          "from_status": "{{deal.status | optional}}"
        },
        "startsWorkflows": true
      },
      "onFailure": "hold"
    },
    {
      "id": "g3",
      "type": "action@1",
      "title": "Record the no-show after an unanswered cancel or reschedule read",
      "action": "facts.record",
      "params": {
        "type": "intent.unanswered_no_show",
        "data": {
          "asked_at": "{{appointment.pending_read.at}}",
          "predicted": "{{appointment.pending_read.intent}}",
          "appointment_id": "{{appointment.id}}",
          "predicted_confidence": "{{appointment.pending_read.confidence}}"
        },
        "startsWorkflows": false
      },
      "onFailure": "hold"
    },
    {
      "id": "b1",
      "type": "branch@1",
      "title": "Did they show?"
    },
    {
      "id": "g4",
      "type": "action@1",
      "title": "Tag stat-possible-cancel: we were pretty sure they cancelled and the slot was never opened",
      "action": "crm.add_tag",
      "params": {
        "tags": [
          "stat-possible-cancel"
        ]
      }
    },
    {
      "id": "s1",
      "type": "message@1",
      "title": "React ✅ on the booking post",
      "to": {
        "slack": {
          "channel": "{{setting.slack.channel.bookings}}"
        }
      },
      "content": "call_outcome_filed.s1",
      "thread": {
        "tag": "appointment:{{appointment.id}}"
      },
      "threadOnly": true,
      "remember": "outcome:{{appointment.id}}"
    },
    {
      "id": "s1_react",
      "type": "action@1",
      "title": "React :white_check_mark: on the post it replies under",
      "action": "slack.react",
      "params": {
        "post": {
          "tag": "appointment:{{appointment.id}}"
        },
        "emojis": [
          "white_check_mark"
        ]
      }
    },
    {
      "id": "s1_undo",
      "type": "branch@1",
      "title": "Which reaction does the earlier answer take back?"
    },
    {
      "id": "s1_undo_ghost",
      "type": "action@1",
      "title": "Take :ghost: off the booking post",
      "action": "slack.unreact",
      "params": {
        "post": {
          "tag": "appointment:{{appointment.id}}"
        },
        "emojis": [
          "ghost"
        ]
      }
    },
    {
      "id": "r3s",
      "type": "message@1",
      "title": "A changed answer: the thread line says rescheduled and the earlier reaction comes off",
      "to": {
        "slack": {
          "channel": "{{setting.slack.channel.bookings}}"
        }
      },
      "content": "call_outcome_filed.r3s",
      "thread": {
        "tag": "appointment:{{appointment.id}}"
      },
      "threadOnly": true,
      "remember": "outcome:{{appointment.id}}"
    },
    {
      "id": "r3s_undo",
      "type": "branch@1",
      "title": "Which reaction does the earlier answer take back?"
    },
    {
      "id": "r3s_undo_ghost",
      "type": "action@1",
      "title": "Take :ghost: off the booking post",
      "action": "slack.unreact",
      "params": {
        "post": {
          "tag": "appointment:{{appointment.id}}"
        },
        "emojis": [
          "ghost"
        ]
      }
    },
    {
      "id": "r3s_undo_white_check_mark",
      "type": "action@1",
      "title": "Take :white_check_mark: off the booking post",
      "action": "slack.unreact",
      "params": {
        "post": {
          "tag": "appointment:{{appointment.id}}"
        },
        "emojis": [
          "white_check_mark"
        ]
      }
    },
    {
      "id": "x0",
      "type": "end@1",
      "title": "Stop: nothing to mark",
      "reason": "nothing_to_mark"
    },
    {
      "id": "r2",
      "type": "action@1",
      "title": "Sales Call record: no-show (what a held call carried is emptied)",
      "action": "crm.upsert_record",
      "params": {
        "object": "{{setting.crm.object_sales_call | default:custom_objects.sales_call}}",
        "properties": {
          "outcome": "{{setting.picklist.sales_call_outcome.noshow}}",
          "external_id": "{{appointment.slot_key}}"
        },
        "ifMissing": "match",
        "key": "{{appointment.slot_key}}",
        "clear": [
          "disposition",
          "cash_collected",
          "objection_primary",
          "next_step",
          "next_step_date",
          "payment_terms"
        ]
      }
    },
    {
      "id": "s2",
      "type": "action@1",
      "title": "Add tag “stat-showed”",
      "action": "crm.add_tag",
      "params": {
        "tags": [
          "stat-showed"
        ]
      }
    },
    {
      "id": "r3",
      "type": "action@1",
      "title": "Sales Call record: rescheduled or cancelled on the call (what a held call carried is emptied)",
      "action": "crm.upsert_record",
      "params": {
        "object": "{{setting.crm.object_sales_call | default:custom_objects.sales_call}}",
        "properties": {
          "outcome": "{{setting.picklist.sales_call_outcome.on_call}}",
          "external_id": "{{appointment.slot_key}}"
        },
        "ifMissing": "match",
        "key": "{{appointment.slot_key}}",
        "clear": [
          "disposition",
          "cash_collected",
          "objection_primary",
          "next_step",
          "next_step_date",
          "payment_terms"
        ]
      }
    },
    {
      "id": "x1",
      "type": "end@1",
      "title": "Stop: noted",
      "reason": "noted"
    },
    {
      "id": "sc1",
      "type": "action@1",
      "title": "Setter card → Showed, won (as the recording path does; a no-op when it is already there)",
      "action": "crm.move_deal",
      "params": {
        "pipeline": "{{setting.crm.pipeline_setter}}",
        "stage": "{{setting.crm.stage_setter_showed}}",
        "ifMissing": "skip",
        "pick": "latest"
      }
    },
    {
      "id": "sc1_status",
      "type": "action@1",
      "title": "Mark that card won",
      "action": "crm.set_deal_status",
      "params": {
        "pipeline": "{{setting.crm.pipeline_setter}}",
        "status": "won"
      }
    },
    {
      "id": "v_disp",
      "type": "set@1",
      "title": "The closer's answer as the CRM's disposition, in the company's own option (sales_call.dispositions): a deposit is its Deposit option, never closed won",
      "var": "disposition",
      "value": "{{appointment.call_outcome | optional}}"
    },
    {
      "id": "r1",
      "type": "action@1",
      "title": "Sales Call record: showed, with the disposition",
      "action": "crm.upsert_record",
      "params": {
        "object": "{{setting.crm.object_sales_call | default:custom_objects.sales_call}}",
        "properties": {
          "outcome": "{{setting.picklist.sales_call_outcome.showed}}",
          "disposition": "{{vars.disposition | optional}}",
          "external_id": "{{appointment.slot_key}}"
        },
        "ifMissing": "match",
        "key": "{{appointment.slot_key}}",
        "clear": [
          "disposition"
        ]
      }
    },
    {
      "id": "b2",
      "type": "branch@1",
      "title": "How did the call go?"
    },
    {
      "id": "c1",
      "type": "action@1",
      "title": "Add tag “stat-closed-won”",
      "action": "crm.add_tag",
      "params": {
        "tags": [
          "stat-closed-won"
        ]
      }
    },
    {
      "id": "c5",
      "type": "action@1",
      "title": "Add tag “stat-deposit”",
      "action": "crm.add_tag",
      "params": {
        "tags": [
          "stat-deposit"
        ]
      }
    },
    {
      "id": "c2",
      "type": "action@1",
      "title": "Add tag “stat-follow-up”",
      "action": "crm.add_tag",
      "params": {
        "tags": [
          "stat-follow-up"
        ]
      }
    },
    {
      "id": "c3",
      "type": "action@1",
      "title": "Add tag “stat-lost”",
      "action": "crm.add_tag",
      "params": {
        "tags": [
          "stat-lost"
        ]
      }
    },
    {
      "id": "c4",
      "type": "action@1",
      "title": "Add tag “stat-disqualified”",
      "action": "crm.add_tag",
      "params": {
        "tags": [
          "stat-disqualified"
        ]
      }
    },
    {
      "id": "kc",
      "type": "action@1",
      "title": "A changed answer to closed: the closer card leaves No Show / Follow Up / Lost / Disqualified / Deposit for Scheduled (Payment recorded and Deal closed move it on)",
      "action": "crm.move_deal",
      "params": {
        "pipeline": "{{setting.crm.pipeline_closer}}",
        "stage": "{{setting.crm.stage_closer_scheduled}}",
        "ifMissing": "skip",
        "pick": "latest"
      }
    },
    {
      "id": "kc_status",
      "type": "action@1",
      "title": "Mark that card open",
      "action": "crm.set_deal_status",
      "params": {
        "pipeline": "{{setting.crm.pipeline_closer}}",
        "status": "open"
      }
    },
    {
      "id": "kd",
      "type": "action@1",
      "title": "Closer card → Deposit (a deposit is not a close: the card waits there for the rest of the payment; skipped when the board has no Deposit stage bound)",
      "action": "crm.move_deal",
      "params": {
        "pipeline": "{{setting.crm.pipeline_closer}}",
        "stage": "{{setting.crm.stage_closer_deposit | optional}}",
        "ifMissing": "skip",
        "pick": "latest"
      }
    },
    {
      "id": "kd_status",
      "type": "action@1",
      "title": "Mark that card open",
      "action": "crm.set_deal_status",
      "params": {
        "pipeline": "{{setting.crm.pipeline_closer}}",
        "status": "open"
      }
    },
    {
      "id": "k2",
      "type": "action@1",
      "title": "Closer card → Follow Up",
      "action": "crm.move_deal",
      "params": {
        "pipeline": "{{setting.crm.pipeline_closer}}",
        "stage": "{{setting.crm.stage_closer_follow_up}}",
        "ifMissing": "skip",
        "pick": "latest"
      }
    },
    {
      "id": "k2_status",
      "type": "action@1",
      "title": "Mark that card open",
      "action": "crm.set_deal_status",
      "params": {
        "pipeline": "{{setting.crm.pipeline_closer}}",
        "status": "open"
      }
    },
    {
      "id": "k3",
      "type": "action@1",
      "title": "Closer card → Lost, marked lost",
      "action": "crm.move_deal",
      "params": {
        "pipeline": "{{setting.crm.pipeline_closer}}",
        "stage": "{{setting.crm.stage_closer_lost}}",
        "ifMissing": "skip",
        "pick": "latest"
      }
    },
    {
      "id": "k3_status",
      "type": "action@1",
      "title": "Mark that card lost",
      "action": "crm.set_deal_status",
      "params": {
        "pipeline": "{{setting.crm.pipeline_closer}}",
        "status": "lost"
      }
    },
    {
      "id": "k4",
      "type": "action@1",
      "title": "Closer card → Disqualified, marked lost",
      "action": "crm.move_deal",
      "params": {
        "pipeline": "{{setting.crm.pipeline_closer}}",
        "stage": "{{setting.crm.stage_closer_disqualified}}",
        "ifMissing": "skip",
        "pick": "latest"
      }
    },
    {
      "id": "k4_status",
      "type": "action@1",
      "title": "Mark that card lost",
      "action": "crm.set_deal_status",
      "params": {
        "pipeline": "{{setting.crm.pipeline_closer}}",
        "status": "lost"
      }
    },
    {
      "id": "o_lost",
      "type": "branch@1",
      "title": "Is the deal open?"
    },
    {
      "id": "o_lost_rec",
      "type": "action@1",
      "title": "Opportunity lost",
      "action": "facts.record",
      "params": {
        "type": "deal.lost",
        "data": {
          "status": "lost",
          "from_status": "{{deal.status | optional}}"
        },
        "startsWorkflows": true
      },
      "onFailure": "hold"
    },
    {
      "id": "u4_if",
      "type": "branch@1",
      "title": "Only if: A changed answer: take off what the earlier answer tagged and this one does not"
    },
    {
      "id": "o_reopen_if",
      "type": "branch@1",
      "title": "Only if: A changed answer takes the loss back: the opportunity is open again"
    },
    {
      "id": "g3_if",
      "type": "branch@1",
      "title": "Only if: Record the no-show after an unanswered cancel or reschedule read"
    },
    {
      "id": "g4_if",
      "type": "branch@1",
      "title": "Only if: Tag stat-possible-cancel: we were pretty sure they cancelled and the slot was never opened"
    },
    {
      "id": "r3s_if",
      "type": "branch@1",
      "title": "Only if: A changed answer: the thread line says rescheduled and the earlier reaction comes off"
    },
    {
      "id": "kc_if",
      "type": "branch@1",
      "title": "Only if: A changed answer to closed: the closer card leaves No Show / Follow Up / Lost / Disqualified / Deposit for Scheduled (Payment recorded and Deal closed move it on)"
    },
    {
      "id": "kd_if",
      "type": "branch@1",
      "title": "Only if: Closer card → Deposit (a deposit is not a close: the card waits there for the rest of the payment; skipped when the board has no Deposit stage bound)"
    }
  ],
  "edges": [
    {
      "from": "t1",
      "to": "u1_key"
    },
    {
      "from": "t2",
      "to": "g1"
    },
    {
      "from": "u1_key",
      "to": "u1"
    },
    {
      "from": "u1",
      "to": "u2_key"
    },
    {
      "from": "g1",
      "to": "g1_react"
    },
    {
      "from": "g1_react",
      "to": "g1_undo"
    },
    {
      "from": "g1_undo",
      "to": "g1_undo_white_check_mark",
      "when": {
        "eq": [
          "{{vars.undo_emoji}}",
          "white_check_mark"
        ]
      },
      "label": "white_check_mark"
    },
