{
  "schema": 2,
  "id": "deal-closed",
  "name": "Deal closed",
  "description": "Once a contact has paid beyond a deposit and signed: tagged stat-customer, both cards won, the Sales Call marked closed won, the welcome email and text sent, and the win posted in the deals channel with an AI cheer line.",
  "origin": {
    "template": "deal-closed",
    "version": 7
  },
  "reentry": {
    "policy": "once_per_contact"
  },
  "premise": {
    "label": "The contact is still in the CRM",
    "holds": {
      "exists": "contact.id"
    },
    "endReason": "contact_gone"
  },
  "sendWindow": {
    "zone": "contact",
    "opens": "08:00",
    "closes": "20:00",
    "outside": "next_open",
    "transactional": "any_hour"
  },
  "delivery": {
    "kind": "human",
    "whenStale": "skip"
  },
  "nodes": [
    {
      "id": "t1",
      "type": "trigger@1",
      "title": "Payment received",
      "on": {
        "event": "payment.received"
      }
    },
    {
      "id": "t2",
      "type": "trigger@1",
      "title": "Agreement signed",
      "on": {
        "event": "agreement.signed"
      }
    },
    {
      "id": "c1",
      "type": "branch@1",
      "title": "Paid beyond a deposit and signed, and not a customer yet (D119: a deposit alone, even signed, is not a close)"
    },
    {
      "id": "c1_x",
      "type": "end@1",
      "title": "Stop: not_yet",
      "reason": "not_yet"
    },
    {
      "id": "g1",
      "type": "action@1",
      "title": "Add tag “stat-customer”",
      "action": "crm.add_tag",
      "params": {
        "tags": [
          "stat-customer"
        ]
      }
    },
    {
      "id": "p1",
      "type": "action@1",
      "title": "Create or move pipeline card",
      "action": "crm.move_deal",
      "params": {
        "pipeline": "{{setting.crm.pipeline_closer}}",
        "stage": "{{setting.crm.stage_closer_closed_won}}",
        "ifMissing": "create",
        "pick": "open"
      }
    },
    {
      "id": "p1_status",
      "type": "action@1",
      "title": "Mark that card won",
      "action": "crm.set_deal_status",
      "params": {
        "pipeline": "{{setting.crm.pipeline_closer}}",
        "status": "won"
      }
    },
    {
      "id": "p2",
      "type": "action@1",
      "title": "Mark that card won",
      "action": "crm.set_deal_status",
      "params": {
        "pipeline": "{{setting.crm.pipeline_setter}}",
        "status": "won"
      }
    },
    {
      "id": "b1",
      "type": "branch@1",
      "title": "Which way?"
    },
    {
      "id": "r1",
      "type": "action@1",
      "title": "Update sales call record",
      "action": "crm.upsert_record",
      "params": {
        "object": "{{setting.crm.object_sales_call | default:custom_objects.sales_call}}",
        "properties": {
          "outcome": "{{setting.picklist.sales_call_outcome.showed}}",
          "disposition": "closed_won",
          "cash_collected": "{{contact.cash_collected}}"
        },
        "ifMissing": "skip",
        "key": "{{contact.records.sales_call.key}}"
      }
    },
    {
      "id": "e1",
      "type": "message@1",
      "title": "Send email: “Welcome — Let's Get You Ready for Your First Coaching Call”",
      "to": {
        "contact": "email"
      },
      "content": "deal_closed.e1",
      "kind": "transactional"
    },
    {
      "id": "e2",
      "type": "message@1",
      "title": "Welcome text",
      "to": {
        "contact": "sms"
      },
      "content": "deal_closed.e2",
      "kind": "transactional"
    },
    {
      "id": "a1",
      "type": "action@1",
      "title": "AI writes from closer and more with the “close cheer” prompt",
      "action": "ai.summarize",
      "params": {
        "prompt": "prompts.close_cheer",
        "input": "Closer: {{contact.closer.name | default:the closer}}\nClient first name: {{contact.first_name | default:the client}}\nCash collected: ${{contact.cash_collected | money}}\nDeal value: ${{contact.revenue | money | default:unknown}}\nDays from first booking to payment: {{contact.days_to_close | default:unknown}}\nLead source: {{contact.source | default:unknown}}",
        "format": "text",
        "maxTokens": 80,
        "optional": true
      },
      "into": "cheer",
      "onFailure": "skip"
    },
    {
      "id": "s1",
      "type": "message@1",
      "title": "Post the win in Slack",
      "to": {
        "slack": {
          "channel": "{{setting.slack.channel.deals}}"
        }
      },
      "content": "deal_closed.s1"
    },
    {
      "id": "x1",
      "type": "end@1",
      "title": "Stop: closed",
      "reason": "closed"
    }
  ],
  "edges": [
    {
      "from": "t1",
      "to": "c1"
    },
    {
      "from": "t2",
      "to": "c1"
    },
    {
      "from": "c1",
      "to": "g1",
      "when": {
        "and": [
          {
            "eq": [
              "{{contact.paid_non_deposit}}",
              true
            ]
          },
          {
            "eq": [
              "{{contact.agreement_signed}}",
              true
            ]
          },
          {
            "not": {
              "has": [
                "{{contact.tags}}",
                "stat-customer"
              ]
            }
          }
        ]
      }
    },
    {
      "from": "c1",
      "to": "c1_x",
      "else": true,
      "label": "not_yet"
    },
    {
      "from": "g1",
      "to": "p1"
    },
    {
      "from": "p1",
      "to": "p1_status"
    },
    {
      "from": "p1_status",
      "to": "p2"
    },
    {
      "from": "p2",
      "to": "b1"
    },
    {
      "from": "b1",
      "to": "r1",
      "label": "has a Sales Call record",
      "when": {
        "exists": "contact.records.sales_call.key"
      }
    },
    {
      "from": "b1",
      "to": "e1",
      "label": "no Sales Call record",
      "else": true
    },
    {
      "from": "r1",
      "to": "e1"
    },
    {
      "from": "e1",
      "to": "e2"
    },
    {
      "from": "e2",
      "to": "a1"
    },
    {
      "from": "a1",
      "to": "s1"
    },
    {
      "from": "s1",
      "to": "x1"
    }
  ]
}
